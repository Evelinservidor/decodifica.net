---
export interface Props {
  plausibleDomain?: string;
  plausibleScriptSrc?: string;
}

const { plausibleDomain, plausibleScriptSrc } = Astro.props;
---

<div
  id="cookie-consent"
  class="aviso-cookies hidden"
  role="dialog"
  aria-live="polite"
  aria-label="Preferencias de privacidad"
>
  <div class="aviso-cookies-fila">
    <p>
      Solo medimos visitas, sin publicidad ni perfiles, <b>si aceptas</b>.{' '}
      <button id="cookie-configure" type="button" class="enlace" aria-expanded="false" aria-controls="cookie-settings">Configurar</button>{' · '}
      <a href="/cookies/">Más información</a>
    </p>
    <div class="aviso-cookies-botones">
      <button id="cookie-reject" type="button">Rechazar</button>
      <button id="cookie-accept" type="button">Aceptar</button>
    </div>
  </div>
  <div id="cookie-settings" class="mt-3 hidden border-t border-dark-600 pt-3">
    <label class="flex items-start gap-3 text-sm text-dark-200">
      <input id="cookie-analytics" type="checkbox" class="mt-1 h-5 w-5 shrink-0" />
      <span><strong class="text-white">Analítica agregada (Plausible)</strong><br />Cuenta páginas vistas sin crear perfiles publicitarios. Los vídeos externos se cargan en modo privacidad.</span>
    </label>
    <div class="aviso-cookies-botones mt-3"><button id="cookie-save" type="button">Guardar mi elección</button></div>
  </div>
</div>

<script is:inline define:vars={{ plausibleDomain, plausibleScriptSrc }}>
  (() => {
    const STORAGE_KEY = 'decodifica_cookie_consent_v1';
    const banner = document.getElementById('cookie-consent');
    const settings = document.getElementById('cookie-settings');
    const analyticsInput = document.getElementById('cookie-analytics');
    const rejectButton = document.getElementById('cookie-reject');
    const configureButton = document.getElementById('cookie-configure');
    const saveButton = document.getElementById('cookie-save');
    const acceptButton = document.getElementById('cookie-accept');

    function readConsent() {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    }

    function writeConsent(options) {
      const value = {
        necessary: true,
        analytics: Boolean(options.analytics),
        savedAt: new Date().toISOString(),
      };
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
      return value;
    }

    function loadPlausible() {
      if (!plausibleDomain || !plausibleScriptSrc || document.querySelector('script[data-plausible-domain="' + plausibleDomain + '"]')) {
        return;
      }
      window.plausible = window.plausible || function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
      window.plausible.init = window.plausible.init || function (options) {
        window.plausible.o = options || {};
      };
      window.plausible.init();
      const script = document.createElement('script');
      script.async = true;
      script.dataset.plausibleDomain = plausibleDomain;
      script.src = plausibleScriptSrc;
      document.head.appendChild(script);
    }

    function applyConsent(consent) {
      if (consent && consent.analytics) {
        loadPlausible();
      }
      window.dispatchEvent(new CustomEvent('decodifica:analytics-consent', {
        detail: { analytics: Boolean(consent && consent.analytics) },
      }));
    }

    function abrir(configurar) {
      const actual = readConsent();
      if (analyticsInput) analyticsInput.checked = Boolean(actual && actual.analytics);
      banner?.classList.remove('hidden');
      if (configurar) {
        settings?.classList.remove('hidden');
        configureButton?.setAttribute('aria-expanded', 'true');
      }
    }

    // «Cambiar cookies» (pie de página y página de cookies): retirar el consentimiento es igual de fácil que darlo.
    document.querySelectorAll('[data-abrir-cookies]').forEach((boton) => {
      boton.addEventListener('click', () => abrir(true));
    });

    const existing = readConsent();
    if (existing) {
      applyConsent(existing);
    } else {
      abrir(false);
    }

    rejectButton?.addEventListener('click', () => {
      writeConsent({ analytics: false });
      banner?.classList.add('hidden');
    });

    acceptButton?.addEventListener('click', () => {
      const consent = writeConsent({ analytics: true });
      applyConsent(consent);
      banner?.classList.add('hidden');
    });

    configureButton?.addEventListener('click', () => {
      const abierto = settings?.classList.toggle('hidden') === false;
      configureButton.setAttribute('aria-expanded', String(abierto));
    });

    saveButton?.addEventListener('click', () => {
      const consent = writeConsent({ analytics: Boolean(analyticsInput?.checked) });
      applyConsent(consent);
      banner?.classList.add('hidden');
    });
  })();
</script>
