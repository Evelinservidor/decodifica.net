---
import { siteConfig } from '~/lib/site-config';
import { portadaDeOg } from '~/lib/portadas';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: 'website' | 'article';
  // Article-specific props
  pubDate?: string; // ISO 8601
  modifiedDate?: string; // ISO 8601
  authorName?: string;
  authorUrl?: string;
  imageAlt?: string;
  keywords?: string[];
  section?: string; // Pilar 1 / Pilar 2
  citations?: string[]; // URLs de las fuentes del artículo
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  canonical = Astro.url.pathname,
  type = 'website',
  pubDate,
  modifiedDate,
  authorName = siteConfig.author.name,
  authorUrl = `${siteConfig.url}/sobre/`,
  imageAlt,
  keywords = [],
  section,
  citations = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteConfig.name}` : `${siteConfig.name} | ${siteConfig.tagline}`;
const canonicalUrl = new URL(canonical, siteConfig.url).toString();
const ogImageUrl = new URL(ogImage, siteConfig.url).toString();
// Portadas del sistema de scripts/imagenes/portada.py: tamaño conocido, alt y versiones
// limpias (sin texto) en 16:9, 4:3 y 1:1 para Google (ver docs/portadas.md).
const portada = portadaDeOg(ogImage);
const ogAlt = portada?.altOg ?? imageAlt;
const ldImages = portada ? portada.ld.map((src) => new URL(src, siteConfig.url).toString()) : [ogImageUrl];

// JSON-LD Organization (site-wide identity): solo en la portada
const isHome = Astro.url.pathname === '/';
const logoUrl = new URL('/og-default.png', siteConfig.url).toString();
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteConfig.url}/#org`,
  name: siteConfig.name,
  url: `${siteConfig.url}/`,
  logo: logoUrl,
  description: siteConfig.description,
  email: siteConfig.author.publicEmailLabel,
  founder: { '@id': `${siteConfig.url}/sobre/#jordi` },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'editorial',
    email: siteConfig.author.publicEmailLabel,
    url: new URL('/contacto/', siteConfig.url).toString(),
    availableLanguage: ['es'],
  },
  sameAs: [
    siteConfig.social.facebook,
    siteConfig.social.bluesky,
    siteConfig.social.reddit,
  ].filter(Boolean),
};

// JSON-LD WebSite: solo en la portada
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteConfig.url}/#website`,
  name: siteConfig.name,
  url: `${siteConfig.url}/`,
  description: siteConfig.description,
  inLanguage: 'es',
  publisher: { '@id': `${siteConfig.url}/#org` },
};

// JSON-LD Article (only when type=article and pubDate is present).
// Es el único bloque Article de cada página: los artículos pasan sus fuentes en `citations`.
const articleLd = type === 'article' && pubDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: title ?? fullTitle,
      description,
      image: ldImages,
      datePublished: pubDate,
      dateModified: modifiedDate ?? pubDate,
      author: {
        '@type': 'Person',
        '@id': `${siteConfig.url}/sobre/#jordi`,
        name: authorName,
        url: authorUrl,
      },
      publisher: {
        '@type': 'Organization',
        '@id': `${siteConfig.url}/#org`,
        name: siteConfig.name,
        url: `${siteConfig.url}/`,
        logo: { '@type': 'ImageObject', url: logoUrl },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${siteConfig.url}/#website`,
        name: siteConfig.name,
        url: `${siteConfig.url}/`,
      },
      ...(section ? { articleSection: section } : {}),
      ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
      ...(citations.length
        ? { citation: citations.map((url) => ({ '@type': 'CreativeWork', url })) }
        : {}),
      inLanguage: 'es',
    }
  : null;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
{portada && <meta property="og:image:width" content="1200" />}
{portada && <meta property="og:image:height" content="630" />}
{portada && <meta property="og:image:type" content="image/jpeg" />}
{ogAlt && <meta property="og:image:alt" content={ogAlt} />}
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="es_ES" />
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate} />}
{type === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{type === 'article' && section && <meta property="article:section" content={section} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}

<!-- Theme -->
<meta name="theme-color" content="#fbfaf7" />
<meta name="color-scheme" content="dark" />

<!-- JSON-LD: Organization y WebSite (portada) -->
{isHome && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
{isHome && <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />}

<!-- JSON-LD: Article (only on blog posts) -->
{articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
