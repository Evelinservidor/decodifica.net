---
import { env } from '~/lib/env';

export interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
}

const {
  title = 'Recibe el filtro Decodifica',
  description = 'Una vez por semana: una herramienta que merece la pena, una decisión práctica y un prompt o recurso para usarla mejor.',
  buttonLabel = 'Apuntarme gratis',
} = Astro.props;

const emailInputId = `bd-email-${title
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '')
  .slice(0, 48) || 'form'}`;
---

<div class="newsletter-card bloque-boletin">
  <h2 class="font-display text-2xl leading-tight text-[#fff]">
    {title}
  </h2>
  <p class="mt-2 text-[15px] leading-6">
    {description}
  </p>

  <form
    action={`https://buttondown.com/api/emails/embed-subscribe/${env.PUBLIC_BUTTONDOWN_USERNAME || 'decodifica'}`}
    method="post"
    data-track="newsletter_submit"
    data-track-component="newsletter_form"
    data-track-label={title}
    class="mt-4 flex flex-wrap gap-2"
  >
    <label for={emailInputId} class="sr-only">Tu email</label>
    <input type="hidden" name="embed" value="1" />
    <input
      id={emailInputId}
      type="email"
      name="email"
      placeholder="tu@email.com"
      required
      autocomplete="email"
      class="newsletter-input min-h-[48px] min-w-0 flex-[1_1_200px] rounded-[10px] border-0 bg-[#fff] px-4 text-base text-[#12142a] placeholder-[#6b7086]"
    />
    <button
      type="submit"
      class="pressable inline-flex min-h-[48px] items-center justify-center rounded-[10px] bg-[#ff9500] px-5 font-bold text-[#1a1200] hover:bg-[#ffa733]"
    >
      {buttonLabel}
    </button>
  </form>

  <p class="mt-3 text-[13px] text-[#c7d2fe]">Gratis, sin spam. Te das de baja con un clic.</p>
</div>
