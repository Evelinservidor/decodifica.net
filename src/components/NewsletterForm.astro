---
import { env } from '~/lib/env';

export interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
}

const {
  title = 'Recibe el filtro Decodifica',
  description = 'Una vez por semana: una herramienta que merece la pena, una decisión práctica y un prompt o recurso para usarla mejor.',
  buttonLabel = 'Apuntarme gratis',
} = Astro.props;

const emailInputId = `bd-email-${title
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '')
  .slice(0, 48) || 'form'}`;
---

<div class="newsletter-card rounded-2xl border border-brand-500/20 bg-gradient-to-br from-dark-700 to-dark-800 p-6 shadow-lg shadow-brand-500/5 sm:p-8">
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-green/30 bg-accent-green/10 px-2.5 py-0.5 text-xs font-medium text-accent-green">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-green"></span>
      Gratis
    </span>
    <span class="text-xs text-dark-300">Lectura corta, decisiones útiles, cero spam.</span>
  </div>

  <h2 class="font-display text-2xl font-bold text-white">
    {title}
  </h2>
  <p class="mt-2 text-sm text-dark-200">
    {description}
  </p>

  <form
    action={`https://buttondown.com/api/emails/embed-subscribe/${env.PUBLIC_BUTTONDOWN_USERNAME || 'decodifica'}`}
    method="post"
    data-track="newsletter_submit"
    data-track-component="newsletter_form"
    data-track-label={title}
    class="mt-5 flex flex-col gap-2 sm:flex-row"
  >
    <label for={emailInputId} class="sr-only">Email</label>
    <input type="hidden" name="embed" value="1" />
    <input
      id={emailInputId}
      type="email"
      name="email"
      placeholder="tu@email.com"
      required
      autocomplete="email"
      class="newsletter-input flex-1 rounded-lg border border-dark-500 bg-dark-900 px-4 py-2.5 text-white placeholder-dark-200 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/20"
    />
    <button
      type="submit"
      class="pressable inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-5 py-2.5 font-semibold text-white transition-[transform,background-color,box-shadow] duration-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-800"
    >
      <span>{buttonLabel}</span>
      <span class="submit-arrow" aria-hidden="true">-&gt;</span>
    </button>
  </form>

  <ul class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-dark-300">
    <li>Sin spam</li>
    <li>Baja en 1 clic</li>
    <li>Recursos prácticos</li>
  </ul>
</div>
