---
import { env } from '~/lib/env';
---

<!--
  Newsletter signup form
  Integrates with Buttondown embed API
  Uses a simple form submission to avoid needing a server endpoint
-->
<div class="rounded-2xl border border-brand-500/20 bg-gradient-to-br from-dark-700 to-dark-800 p-6 sm:p-8 shadow-lg shadow-brand-500/5">
  <h3 class="font-display text-2xl font-bold text-white">
    Únete a la newsletter
  </h3>
  <p class="mt-2 text-sm text-dark-200">
    Cada sábado por la mañana: 1 video destacado, 2-3 noticias IA, 1 prompt útil. Gratis.
  </p>

  <form
    action={`https://buttondown.email/${env.PUBLIC_BUTTONDOWN_USERNAME || 'decodifica'}`}
    method="post"
    target="_blank"
    class="mt-4 flex flex-col gap-2 sm:flex-row"
  >
    <label for="bd-email" class="sr-only">Email</label>
    <input
      id="bd-email"
      type="email"
      name="email"
      placeholder="tu@email.com"
      required
      autocomplete="email"
      class="flex-1 rounded-lg border border-dark-500 bg-dark-900 px-4 py-2.5 text-white placeholder-dark-200 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/20"
    />
    <button
      type="submit"
      class="rounded-lg bg-brand-500 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-800"
    >
      Suscribirme
    </button>
  </form>

  <p class="mt-3 text-xs text-dark-300">
    Sin spam. Te puedes dar de baja cuando quieras.
  </p>
</div>
