---
import { siteConfig } from '~/lib/site-config';

const year = new Date().getFullYear();
---

<footer class="border-t border-dark-600 bg-dark-800">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-white">
          <span class="theme-brand-mark inline-flex h-7 w-7 items-center justify-center rounded-lg bg-brand-500 text-sm font-bold text-white">D</span>
          <span class="font-display">{siteConfig.name}</span>
        </a>
        <p class="mt-3 max-w-md text-sm text-dark-200">
          {siteConfig.description}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Web</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/blog" class="text-dark-200 hover:text-brand-400">Blog</a></li>
          <li><a href="/herramientas" class="text-dark-200 hover:text-brand-400">Herramientas IA</a></li>
          <li><a href="/recursos" class="text-dark-200 hover:text-brand-400">Recursos IA</a></li>
          <li><a href="/newsletter" class="text-dark-200 hover:text-brand-400">Newsletter</a></li>
          <li><a href="/comunidad" class="text-dark-200 hover:text-brand-400">Comunidad</a></li>
          <li><a href="/quienes-somos" class="text-dark-200 hover:text-brand-400">Quiénes somos</a></li>
          <li><a href="/decodifica" class="text-dark-200 hover:text-brand-400">Canal de YouTube</a></li>
          <li><a href="/sobre" class="text-dark-200 hover:text-brand-400">Misión y método</a></li>
          <li><a href="/contacto" class="text-dark-200 hover:text-brand-400">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Seguir</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={siteConfig.social.youtube} class="text-dark-200 hover:text-brand-400" target="_blank" rel="noopener">YouTube</a></li>
          {siteConfig.social.facebook && (
            <li><a href={siteConfig.social.facebook} class="text-dark-200 hover:text-brand-400" target="_blank" rel="noopener">Facebook</a></li>
          )}
          {siteConfig.social.bluesky && (
            <li><a href={siteConfig.social.bluesky} class="text-dark-200 hover:text-brand-400" target="_blank" rel="noopener">Bluesky</a></li>
          )}
          {siteConfig.social.tiktok && (
            <li><a href={siteConfig.social.tiktok} class="text-dark-200 hover:text-brand-400" target="_blank" rel="noopener">TikTok</a></li>
          )}
          {siteConfig.social.reddit && (
            <li><a href={siteConfig.social.reddit} class="text-dark-200 hover:text-brand-400" target="_blank" rel="noopener">Reddit</a></li>
          )}
          <li><a href={siteConfig.newsletter.url} class="text-dark-200 hover:text-brand-400" target="_blank" rel="noopener">Archivo Buttondown</a></li>
          <li><a href={`mailto:${siteConfig.author.email}`} class="text-dark-200 hover:text-brand-400">{siteConfig.author.publicEmailLabel}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-dark-600 pt-6 sm:flex-row">
      <p class="text-xs text-dark-300">
        Copyright {year} {siteConfig.name}. IA práctica, sin ruido.
      </p>
      <ul class="flex gap-4 text-xs">
        <li><a href="/aviso-legal" class="text-dark-300 hover:text-brand-400">Aviso legal</a></li>
        <li><a href="/privacidad" class="text-dark-300 hover:text-brand-400">Privacidad</a></li>
        <li><a href="/cookies" class="text-dark-300 hover:text-brand-400">Cookies</a></li>
        <li><a href="/contacto" class="text-dark-300 hover:text-brand-400">Contacto</a></li>
      </ul>
    </div>
  </div>
</footer>
