---
import { siteConfig } from '~/lib/site-config';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/empieza', label: 'Empieza' },
  { href: '/blog', label: 'Guías' },
  { href: '/herramientas', label: 'Herramientas' },
  { href: '/comunidad', label: 'Comunidad' },
];
---

<header class="site-header sticky top-0 z-50 border-b border-dark-600 bg-dark-800/90 backdrop-blur-md">
  <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8" aria-label="Navegación principal">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="site-logo pressable flex items-center gap-2 text-xl font-bold text-white">
        <span class="theme-brand-mark brand-mark inline-flex h-7 w-7 items-center justify-center rounded-lg bg-brand-500 text-sm font-bold text-white">D</span>
        <span class="font-display">{siteConfig.name}</span>
      </a>

      <ul class="hidden items-center gap-3 lg:flex xl:gap-4">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'site-nav-link text-sm font-medium',
                currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                  ? 'text-brand-400'
                  : 'text-dark-200 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2 sm:gap-3">
        <button
          id="theme-toggle"
          type="button"
          class="pressable inline-flex h-10 items-center gap-2 rounded-lg border border-dark-600 bg-dark-700 px-3 text-sm font-semibold text-white transition-[transform,border-color,background-color] duration-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-800"
          aria-label="Cambiar a tema claro"
          title="Cambiar tema"
        >
          <span aria-hidden="true">☼</span><span class="hidden sm:inline" data-theme-label>Tema claro</span>
        </button>
        <div class="hidden items-center xl:flex">
          <Button href="/newsletter" variant="primary" size="sm">
            Newsletter
          </Button>
        </div>
      </div>

      <button
        id="mobile-menu-button"
        type="button"
        class="pressable inline-flex h-10 w-10 items-center justify-center rounded-lg border border-dark-600 bg-dark-900 text-white transition-[transform,border-color,background-color] duration-200 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-800 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Abrir menú</span>
        <span class="relative h-4 w-5" aria-hidden="true">
          <span class="menu-line absolute left-0 top-0 h-0.5 w-5 rounded bg-current transition-transform"></span>
          <span class="menu-line absolute left-0 top-1.5 h-0.5 w-5 rounded bg-current transition-opacity"></span>
          <span class="menu-line absolute left-0 top-3 h-0.5 w-5 rounded bg-current transition-transform"></span>
        </span>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden">
      <div class="mt-3 border-t border-dark-600 pb-2 pt-3">
        <ul class="grid gap-1">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-lg px-3 py-2 text-base font-semibold transition-colors',
                  currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                    ? 'bg-brand-500/10 text-brand-300'
                    : 'text-dark-100 hover:bg-dark-700 hover:text-white',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4">
          <a
            href="/newsletter"
            class="cta-primary inline-flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold transition"
          >
            Recibir el filtro semanal
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector('#mobile-menu-button');
  const menu = document.querySelector('#mobile-menu');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    button.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('hidden', isOpen);
    button.classList.toggle('is-open', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      button?.setAttribute('aria-expanded', 'false');
      button?.setAttribute('aria-label', 'Abrir menú');
      button?.classList.remove('is-open');
      menu.classList.add('hidden');
    });
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');

  const setTheme = (theme: 'dark' | 'light') => {
    document.documentElement.dataset.theme = theme;
    themeToggle?.setAttribute('aria-label', theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
    if (themeLabel) themeLabel.textContent = theme === 'dark' ? 'Tema claro' : 'Tema oscuro';
  };

  setTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    setTheme(nextTheme);
    try {
      localStorage.setItem('decodifica-theme', nextTheme);
    } catch {}
  });
</script>

<style>
  #mobile-menu-button.is-open .menu-line:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  #mobile-menu-button.is-open .menu-line:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button.is-open .menu-line:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
