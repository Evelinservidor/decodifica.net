---
import { siteConfig } from '~/lib/site-config';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/blog/', label: 'Guías' },
  { href: '/herramientas/', label: 'Herramientas' },
  { href: '/recursos/', label: 'Recursos' },
  { href: '/newsletter/', label: 'Boletín' },
];
const activo = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="site-header sticky top-0 z-50 border-b border-dark-600 bg-dark-900/95 backdrop-blur-md">
  <nav class="contenedor flex h-14 items-center justify-between gap-4" aria-label="Navegación principal">
    <a href="/" class="site-logo flex items-center gap-2 text-[21px] text-white">
      <span class="theme-brand-mark brand-mark inline-flex h-7 w-7 items-center justify-center rounded-lg fondo-indigo font-display text-[15px] text-white" aria-hidden="true">D</span>
      <span class="font-display">{siteConfig.name}</span>
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={activo(item.href) ? 'page' : undefined}
            class:list={['site-nav-link text-[15px] font-semibold', activo(item.href) ? 'text-brand-400' : 'text-white hover:text-brand-400']}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <a href="/blog/#buscar" class="cabecera-boton" aria-label="Buscar guías" title="Buscar guías">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <button id="theme-toggle" type="button" class="cabecera-boton" aria-label="Cambiar a modo oscuro" title="Cambiar tema">
        <svg class="icono-luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="icono-sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <button
        id="mobile-menu-button"
        type="button"
        class="cabecera-boton lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="relative h-4 w-5" aria-hidden="true">
          <span class="menu-line absolute left-0 top-0 h-0.5 w-5 rounded bg-current transition-transform"></span>
          <span class="menu-line absolute left-0 top-1.5 h-0.5 w-5 rounded bg-current transition-opacity"></span>
          <span class="menu-line absolute left-0 top-3 h-0.5 w-5 rounded bg-current transition-transform"></span>
        </span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-dark-600 lg:hidden">
    <ul class="contenedor grid gap-1 py-3">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={activo(item.href) ? 'page' : undefined}
            class:list={['flex min-h-[44px] items-center rounded-lg px-3 text-base font-semibold', activo(item.href) ? 'bg-brand-500/10 text-brand-400' : 'text-white hover:bg-dark-700']}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li><a href="/empieza/" class="flex min-h-[44px] items-center rounded-lg px-3 text-base font-semibold text-white hover:bg-dark-700">Empieza por tu tarea</a></li>
    </ul>
  </div>
</header>

<script>
  const button = document.querySelector('#mobile-menu-button');
  const menu = document.querySelector('#mobile-menu');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    button.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('hidden', isOpen);
    button.classList.toggle('is-open', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      button?.setAttribute('aria-expanded', 'false');
      button?.setAttribute('aria-label', 'Abrir menú');
      button?.classList.remove('is-open');
      menu.classList.add('hidden');
    });
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

  const setTheme = (theme: 'dark' | 'light') => {
    document.documentElement.dataset.theme = theme;
    themeToggle?.setAttribute('aria-label', theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
  };

  setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    setTheme(nextTheme);
    try {
      localStorage.setItem('decodifica-theme', nextTheme);
    } catch {}
  });
</script>

<style>
  .cabecera-boton {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    color: var(--tinta);
  }

  @media (min-width: 1024px) {
    #mobile-menu-button {
      display: none;
    }
  }

  .cabecera-boton:hover {
    background: rgb(var(--theme-700));
  }

  .cabecera-boton svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icono-sol,
  :global(:root[data-theme='dark']) .icono-luna {
    display: none;
  }

  :global(:root[data-theme='dark']) .icono-sol {
    display: block;
  }

  #mobile-menu-button.is-open .menu-line:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  #mobile-menu-button.is-open .menu-line:nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button.is-open .menu-line:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
