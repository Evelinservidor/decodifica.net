---
import { siteConfig } from '~/lib/site-config';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/blog', label: 'Blog' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/comunidad', label: 'Comunidad' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/decodifica', label: 'Canal' },
];
---

<header class="sticky top-0 z-50 border-b border-dark-600 bg-dark-800/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-white">
      <span class="text-brand-400">●</span>
      <span class="font-display">{siteConfig.name}</span>
    </a>

    <ul class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-brand-400'
                : 'text-dark-200 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <Button href="/recursos" variant="ghost" size="sm" class="hidden sm:inline-flex">
        Recursos gratis
      </Button>
      <Button href="/comunidad" variant="primary" size="sm">
        Entrar
      </Button>
    </div>
  </nav>
</header>
