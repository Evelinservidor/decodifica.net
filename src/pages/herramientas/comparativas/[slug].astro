---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { toolComparisons } from '~/data/tool-comparisons';
import { getToolBySlug } from '~/data/tools';
import { siteConfig } from '~/lib/site-config';

export function getStaticPaths() {
  return toolComparisons.map((comparison) => ({ params: { slug: comparison.slug }, props: { comparison } }));
}

const { comparison } = Astro.props;
const left = getToolBySlug(comparison.left);
const right = getToolBySlug(comparison.right);
if (!left || !right) throw new Error(`Missing comparison tools for ${comparison.slug}`);
const pageUrl = `${siteConfig.url}/herramientas/comparativas/${comparison.slug}/`;
const rows = [
  ['Mejor encaje', left.bestFor, right.bestFor],
  ['Evítala si', left.avoidIf, right.avoidIf],
  ['Precio', left.price, right.price],
  ['Privacidad', left.privacy, right.privacy],
  ['Dificultad', left.difficulty, right.difficulty],
  ['Plataformas', left.platforms?.join(', ') ?? 'Web', right.platforms?.join(', ') ?? 'Web'],
  ['Verificación', left.verifiedAt ?? '2026-07-14', right.verifiedAt ?? '2026-07-14'],
];
---

<BaseLayout title={comparison.seoTitle ?? `${comparison.title}: cuál elegir`} description={comparison.description} type="article" modifiedDate="2026-07-14" section="Comparativas IA">
  <article class="page-shell mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8" data-track-read-min="comparison_read_minimum" data-track-label={comparison.slug} data-track-component="comparison_detail">
    <nav class="text-sm text-dark-300" aria-label="Migas de pan"><a href="/herramientas/" class="text-brand-300 hover:text-brand-200">Herramientas IA</a><span class="mx-2">/</span><span>Comparativas</span></nav>
    <header class="page-hero mt-8 max-w-4xl">
      <p class="eyebrow inline-flex rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">Comparativa práctica · revisada el 14 de julio de 2026</p>
      <h1 class="text-balance mt-5 font-display text-4xl font-bold sm:text-5xl">{comparison.title}: qué abrir primero</h1>
      <p class="mt-5 text-lg leading-8 text-dark-200">{comparison.description}</p>
    </header>

    <section class="mt-10 rounded-lg border border-brand-500/30 bg-dark-800 p-6 lg:p-8">
      <p class="text-sm font-semibold text-brand-300">Decisión rápida</p>
      <h2 class="mt-2 font-display text-2xl font-bold text-white">La tarea decide más que la marca</h2>
      <p class="mt-4 leading-7 text-dark-200">{comparison.verdict}</p>
    </section>

    <section class="surface-panel mt-10 overflow-x-auto rounded-xl border border-dark-600 bg-dark-800">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="border-b border-dark-600 bg-dark-900"><tr><th class="p-4 text-dark-300">Criterio</th><th class="p-4 text-white">{left.name}</th><th class="p-4 text-white">{right.name}</th></tr></thead>
        <tbody>{rows.map(([label, leftValue, rightValue]) => <tr class="border-b border-dark-600 last:border-0"><th class="p-4 align-top text-dark-300">{label}</th><td class="p-4 align-top leading-6 text-dark-200">{leftValue}</td><td class="p-4 align-top leading-6 text-dark-200">{rightValue}</td></tr>)}</tbody>
      </table>
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6"><h2 class="font-display text-2xl font-bold">Elige {left.name} si...</h2><ul class="mt-4 space-y-3 text-dark-200">{comparison.chooseLeft.map((item) => <li>{item}</li>)}</ul><a href={`/herramientas/${left.slug}/`} data-track="comparison_tool_opened" data-track-label={`${comparison.slug}:${left.slug}`} class="mt-6 inline-flex font-semibold text-brand-300">Ver ficha de {left.name} →</a></div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6"><h2 class="font-display text-2xl font-bold">Elige {right.name} si...</h2><ul class="mt-4 space-y-3 text-dark-200">{comparison.chooseRight.map((item) => <li>{item}</li>)}</ul><a href={`/herramientas/${right.slug}/`} data-track="comparison_tool_opened" data-track-label={`${comparison.slug}:${right.slug}`} class="mt-6 inline-flex font-semibold text-brand-300">Ver ficha de {right.name} →</a></div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6"><h2 class="font-display text-2xl font-bold">Riesgos compartidos</h2><ul class="mt-4 grid gap-3 md:grid-cols-3">{comparison.sharedRisks.map((risk) => <li class="rounded-lg bg-dark-900 p-4 text-sm leading-6 text-dark-200">{risk}</li>)}</ul></section>

    <section class="surface-panel mt-10 rounded-xl border border-dark-600 bg-dark-800 p-6"><h2 class="font-display text-2xl font-bold">Haz tu propia comparación</h2><p class="mt-3 text-dark-200">Selecciona cualquier combinación de la biblioteca y conserva la URL para volver al mismo resultado.</p><a href={`/herramientas/comparador/?tools=${left.slug},${right.slug}`} data-track="comparison_builder_opened" data-track-label={comparison.slug} class="cta-primary pressable mt-5 inline-flex rounded-lg px-4 py-2.5 font-semibold">Abrir comparador</a></section>

    <div class="mt-12"><NewsletterForm title="Recibe comparativas con una decisión clara" description="Una vez por semana: qué probar, qué evitar y qué comprobar antes de pagar." buttonLabel="Recibir el filtro" /></div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Herramientas IA', item: `${siteConfig.url}/herramientas/` }, { '@type': 'ListItem', position: 2, name: comparison.title, item: pageUrl }] })} />
</BaseLayout>
