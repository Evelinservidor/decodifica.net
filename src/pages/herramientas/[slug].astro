---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { detailedTools, tools } from '~/data/tools';
import { siteConfig } from '~/lib/site-config';

export function getStaticPaths() {
  return detailedTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const detail = tool.detail;
const otherTools = tools
  .filter((candidate) => candidate.slug !== tool.slug && candidate.useCase === tool.useCase)
  .slice(0, 3);

const pageUrl = `${siteConfig.url}/herramientas/${tool.slug}/`;
const freshnessLabel = tool.freshnessStatus === 'review-due'
  ? 'Revisión pendiente'
  : tool.freshnessStatus === 'due-soon'
    ? 'Revisión próxima'
    : 'Al día';
const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  url: tool.officialUrl,
  applicationCategory: tool.useCase,
  operatingSystem: 'Web',
  description: tool.metaDescription,
  sameAs: tool.officialUrl,
};
---

<BaseLayout
  title={`${tool.name}: guía práctica y cuándo usarla`}
  description={tool.metaDescription}
  type="article"
  pubDate="2026-07-07"
  modifiedDate={tool.verifiedAt ?? '2026-07-14'}
  keywords={tool.tags}
  section="Herramientas IA"
>
  <article class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8" data-track-read-min="tool_ficha_read_minimum" data-track-label={tool.slug} data-track-component="tool_detail">
    <nav class="mb-8 text-sm text-dark-300" aria-label="Migas de pan">
      <a href="/herramientas/" class="text-brand-300 hover:text-brand-200">Herramientas IA</a>
      <span class="mx-2">/</span>
      <span>{tool.name}</span>
    </nav>

    <header class="grid gap-8 lg:grid-cols-[1fr_340px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Ficha práctica
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          {tool.name}: cuándo usarla y cuándo evitarla
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-dark-200">
          {tool.summary}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-lg bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{tool.useCase}</span>
          <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1 text-xs text-dark-200">{tool.price}</span>
          <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1 text-xs text-dark-200">Privacidad {tool.privacy}</span>
          <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1 text-xs text-dark-200">Dificultad {tool.difficulty}</span>
          <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1 text-xs text-dark-200">Última revisión {tool.verifiedAt}</span>
          <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1 text-xs text-dark-200">Próxima {tool.nextReviewAt}</span>
          <span class:list={['rounded-lg border px-3 py-1 text-xs font-semibold', tool.freshnessStatus === 'review-due' ? 'border-red-300/40 bg-red-300/10 text-red-200' : tool.freshnessStatus === 'due-soon' ? 'border-amber-300/40 bg-amber-300/10 text-amber-100' : 'border-emerald-300/30 bg-emerald-300/10 text-emerald-200']}>{freshnessLabel}</span>
        </div>
        <p class="mt-4 text-xs leading-5 text-dark-400">Evidencia: {tool.evidenceLevel === 'decodifica-test' ? 'prueba documentada de Decodifica' : tool.evidenceLevel === 'controlled-test' ? 'prueba controlada' : 'fuentes oficiales; sin afirmar prueba propia'} · Cadencia: {tool.reviewCadenceDays} días · Estado del producto: {tool.status}</p>
      </div>

      <aside class="rounded-lg border border-dark-600 bg-dark-800 p-5">
        <h2 class="font-display text-xl font-bold text-white">Decisión rápida</h2>
        <p class="mt-3 text-sm leading-6 text-dark-200">{tool.bestFor}</p>
        <div class="mt-5 grid gap-2">
          <a href={tool.officialUrl} target="_blank" rel="noopener" data-track="official_tool_click" data-track-label={tool.slug} data-track-component="tool_detail" class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
            Ver página oficial
          </a>
          <a href="#newsletter" class="inline-flex items-center justify-center rounded-lg border border-brand-700 px-4 py-2.5 text-sm font-semibold text-brand-300 transition hover:bg-dark-700">
            Recibir el filtro
          </a>
        </div>
      </aside>
    </header>

    <section class="prose prose-invert mt-12 max-w-none text-dark-200">
      <h2>Veredicto Decodifica</h2>
      <p>{detail.verdict}</p>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Úsala cuando</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
          {detail.idealFor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Evítala si</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
          {detail.notFor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Flujo recomendado</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-2">
        {detail.workflow.map((step, index) => (
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200">
            <span class="text-xs font-semibold text-brand-300">Paso {index + 1}</span>
            <p class="mt-1">{step}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Precio y limites</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
          {detail.priceNotes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Privacidad</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
          {detail.privacyNotes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Alternativas a considerar</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {detail.alternatives.map((alternative) => (
          <span class="rounded-lg bg-dark-900 px-3 py-1.5 text-sm text-dark-200">{alternative}</span>
        ))}
      </div>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Guías relacionadas</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          {tool.relatedLinks.map((link) => (
            <li><a href={link.href} data-track={link.href.includes('-vs-') || link.href.includes('alternativas-') ? 'tool_to_comparison_click' : 'tool_related_click'} data-track-label={`${tool.slug}:${link.label}`} data-track-component="tool_detail_related" class="text-brand-300 hover:text-brand-200">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Fuentes</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          {detail.sources.map((source) => (
            <li><a href={source.href} target="_blank" rel="noopener" data-track="tool_source_click" data-track-label={`${tool.slug}:${source.label}`} data-track-component="tool_detail_sources" class="text-brand-300 hover:text-brand-200">{source.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Otras herramientas del mapa</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {otherTools.map((candidate) => (
          <a href={candidate.hasDetailPage ? `/herramientas/${candidate.slug}/` : candidate.officialUrl} target={candidate.hasDetailPage ? undefined : '_blank'} rel={candidate.hasDetailPage ? undefined : 'noopener'} class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
            <h3 class="font-display text-lg font-bold text-white">{candidate.name}</h3>
            <p class="mt-2 text-sm leading-6 text-dark-300">{candidate.bestFor}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-brand-500/30 bg-dark-800 p-6">
      <p class="text-sm font-semibold text-brand-300">Recurso Decodifica</p>
      <h2 class="mt-2 font-display text-2xl font-bold text-white">No elijas esta herramienta en aislamiento</h2>
      <p class="mt-3 text-sm leading-6 text-dark-200">
        Usa el mapa de herramientas IA para decidir si {tool.name} es la primera app que deberías abrir o si te conviene empezar por otra según la tarea.
      </p>
      <a href="/recursos/mapa-herramientas-ia/" class="mt-5 inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
        Abrir el mapa
      </a>
      <a href={`/herramientas/evaluador/?tool=${tool.slug}`} class="ml-3 mt-5 inline-flex rounded-lg border border-brand-700 px-4 py-2.5 text-sm font-semibold text-brand-300">
        Evaluar una prueba
      </a>
    </section>

    <div id="newsletter" class="mt-12">
      <NewsletterForm
        title={`Recibe el filtro Decodifica sobre ${tool.name}`}
        description="Una vez por semana: qué herramienta mirar, para qué sirve y qué comprobar antes de pagar o subir datos."
        buttonLabel="Recibir el filtro"
      />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Herramientas IA',
        item: `${siteConfig.url}/herramientas/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: tool.name,
        item: pageUrl,
      },
    ],
  })} />
</BaseLayout>
