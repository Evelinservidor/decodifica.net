---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Preflight de datos para herramientas IA" description="Revisa sensibilidad, permisos, retención y consecuencias antes de subir información a una herramienta de IA.">
  <main class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8"><header class="max-w-4xl"><p class="inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">Checklist operativo · no es asesoramiento legal</p><h1 class="mt-5 font-display text-4xl font-bold sm:text-5xl">Antes de subir datos, comprueba el riesgo</h1><p class="mt-5 text-lg leading-8 text-dark-200">Cinco preguntas generan una orientación operativa. No pegues documentos, nombres ni cifras: solo selecciona categorías.</p></header>
    <form id="risk-form" class="mt-10 grid gap-5 rounded-lg border border-dark-600 bg-dark-800 p-6">{[
      ['sensitivity','1. Sensibilidad','¿Qué tipo de información usarás?',[['public','Pública'],['internal','Interna'],['sensitive','Personal, confidencial o regulada']]],
      ['permission','2. Permiso','¿Tienes derecho y permiso para procesarla?',[['yes','Sí'],['unclear','No está claro'],['no','No']]],
      ['terms','3. Condiciones','¿Has revisado plan, retención y uso de datos?',[['yes','Sí'],['partial','Solo parcialmente'],['no','No']]],
      ['impact','4. Consecuencia','¿Qué ocurre si la salida está mal?',[['low','Se corrige antes de usar'],['medium','Puede afectar a otra persona'],['high','Puede ejecutar, publicar, pagar o decidir']]],
      ['review','5. Revisión','¿Habrá una persona que contraste entrada y salida?',[['yes','Sí, siempre'],['sometimes','Solo algunas veces'],['no','No']]],
    ].map(([id,label,question,options]) => <label class="block rounded-lg bg-dark-900 p-4"><span class="font-semibold text-white">{label}</span><span class="mt-1 block text-sm text-dark-300">{question}</span><select required id={`risk-${id}`} class="mt-3 w-full rounded-lg border border-dark-600 bg-dark-800 px-3 py-3"><option value="">Selecciona</option>{options.map(([value,text])=><option value={value}>{text}</option>)}</select></label>)}<button class="w-fit rounded-lg bg-brand-500 px-5 py-3 font-semibold text-white">Evaluar riesgo</button><p id="risk-error" class="hidden text-sm text-red-300" role="alert">Responde las cinco preguntas.</p></form>
    <section id="risk-result" hidden class="mt-8 rounded-lg border border-dark-600 bg-dark-800 p-6" aria-live="polite"><p id="risk-level" class="text-sm font-semibold uppercase tracking-wide"></p><h2 id="risk-title" class="mt-2 font-display text-3xl font-bold"></h2><p id="risk-summary" class="mt-4 leading-7 text-dark-200"></p><ul id="risk-actions" class="mt-6 grid gap-3 md:grid-cols-2"></ul><div class="mt-6 flex flex-wrap gap-3"><button id="risk-print" type="button" class="rounded-lg border border-dark-600 px-4 py-2.5 font-semibold">Imprimir checklist</button><a href="/herramientas/" class="rounded-lg bg-brand-500 px-4 py-2.5 font-semibold text-white">Elegir herramienta</a></div></section>
  </main>
  <script>
    const form=document.querySelector('#risk-form'); const output=document.querySelector('#risk-result'); const ids=['sensitivity','permission','terms','impact','review']; const values=()=>Object.fromEntries(ids.map((id)=>[id,document.querySelector(`#risk-${id}`)?.value||'']));
    form?.addEventListener('submit',(event)=>{event.preventDefault(); const data=values(); if(Object.values(data).some((item)=>!item)){document.querySelector('#risk-error')?.classList.remove('hidden');return;} document.querySelector('#risk-error')?.classList.add('hidden'); let score=0; score+=({public:0,internal:2,sensitive:4})[data.sensitivity]; score+=({yes:0,unclear:3,no:6})[data.permission]; score+=({yes:0,partial:2,no:4})[data.terms]; score+=({low:0,medium:2,high:5})[data.impact]; score+=({yes:0,sometimes:2,no:5})[data.review]; const level=score>=12?'alto':score>=6?'medio':'bajo'; const config={bajo:['Riesgo operativo bajo','Puedes hacer una prueba pequeña, manteniendo revisión y una copia del original.'],medio:['Riesgo operativo medio','Reduce los datos, revisa condiciones y añade una confirmación humana antes de usar la salida.'],alto:['Riesgo operativo alto','No subas ni automatices todavía. Cambia el flujo, anonimiza o usa un entorno aprobado.']}[level]; document.querySelector('#risk-level').textContent=level; document.querySelector('#risk-level').className=`text-sm font-semibold uppercase tracking-wide ${level==='alto'?'text-red-300':level==='medio'?'text-amber-200':'text-emerald-300'}`; document.querySelector('#risk-title').textContent=config[0]; document.querySelector('#risk-summary').textContent=config[1]; const actions=['Usa solo los campos necesarios.','Elimina nombres, identificadores y secretos.','Revisa retención, entrenamiento y región.','Conserva una copia del original.','Contrasta hechos y cifras.','No ejecutes acciones irreversibles sin confirmación.']; const list=document.querySelector('#risk-actions'); list.replaceChildren(...actions.map((item)=>{const li=document.createElement('li');li.className='rounded-lg bg-dark-900 p-4 text-sm text-dark-200';li.textContent=item;return li;})); output.hidden=false; output.scrollIntoView({behavior:'smooth'}); window.DecodificaTrack?.emit?.('utility_complete',{component:'data_preflight',risk:level,sensitivity:data.sensitivity,impact:data.impact}); });
    document.querySelector('#risk-print')?.addEventListener('click',()=>{window.print();window.DecodificaTrack?.emit?.('utility_print',{component:'data_preflight'});});
  </script>
</BaseLayout>
