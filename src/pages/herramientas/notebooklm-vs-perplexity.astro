---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { siteConfig } from '~/lib/site-config';

const pageUrl = `${siteConfig.url}/herramientas/notebooklm-vs-perplexity/`;
const title = 'NotebookLM vs Perplexity: cuál es mejor y qué dan gratis';
const description = 'NotebookLM (ahora Gemini Notebook) trabaja con tus documentos y Perplexity busca en la web con fuentes. Qué da gratis cada uno y cuándo usar los dos.';

const rows = [
  {
    criterion: 'Punto de partida',
    notebooklm: 'Trabaja mejor cuando ya tienes fuentes: PDFs, notas, enlaces, transcripciones o documentos que quieres entender.',
    perplexity: 'Trabaja mejor cuando aún no sabes qué fuentes leer y necesitas descubrir contexto en la web.',
    winner: 'Depende de si ya tienes fuentes',
  },
  {
    criterion: 'Fuentes propias',
    notebooklm: 'Su ventaja principal es preguntar y organizar material que tú aportas al cuaderno.',
    perplexity: 'Puede usar enlaces y archivos, pero su identidad principal sigue siendo búsqueda y respuesta con fuentes web.',
    winner: 'NotebookLM',
  },
  {
    criterion: 'Búsqueda web',
    notebooklm: 'Puede ayudar con investigación, pero no es el sustituto natural de un buscador con IA.',
    perplexity: 'Está pensado para buscar, citar y explorar información pública de forma rápida.',
    winner: 'Perplexity',
  },
  {
    criterion: 'Estudio y aprendizaje',
    notebooklm: 'Muy fuerte para convertir materiales en resumen, preguntas, guías y audio sobre tus fuentes.',
    perplexity: 'Bueno para entender un tema desde cero y encontrar lecturas, pero menos centrado en tu biblioteca propia.',
    winner: 'NotebookLM',
  },
  {
    criterion: 'Investigación rápida',
    notebooklm: 'Mejor cuando ya has reunido documentos y quieres interrogarlos.',
    perplexity: 'Mejor para orientarte rápido, localizar fuentes y decidir qué merece lectura profunda.',
    winner: 'Perplexity',
  },
  {
    criterion: 'Privacidad',
    notebooklm: 'Depende de cuenta, configuración y uso. Google publica condiciones específicas para NotebookLM y feedback.',
    perplexity: 'Evita introducir datos privados si la tarea puede resolverse con fuentes públicas.',
    winner: 'Revisar caso',
  },
];

const decisions = [
  {
    title: 'Elige NotebookLM si...',
    items: [
      'Ya tienes PDFs, notas, webs, vídeos o documentos que quieres entender.',
      'Necesitas respuestas ancladas a fuentes concretas.',
      'Quieres estudiar, resumir o preparar una reunión con material propio.',
      'Te interesa convertir fuentes en guías, preguntas o audio para repasar.',
    ],
  },
  {
    title: 'Elige Perplexity si...',
    items: [
      'Todavía no sabes qué fuentes son relevantes.',
      'Quieres contexto rápido antes de leer a fondo.',
      'Necesitas encontrar páginas oficiales, artículos, informes o comparativas.',
      'Buscas una primera respuesta con enlaces para abrir y verificar.',
    ],
  },
];

const useCases = [
  {
    task: 'Tengo un PDF largo y quiero entenderlo',
    choice: 'NotebookLM',
    reason: 'Sube el documento, pregunta por estructura, puntos clave y citas. Aquí gana trabajar sobre tu fuente.',
  },
  {
    task: 'No sé por dónde empezar un tema',
    choice: 'Perplexity',
    reason: 'Empieza buscando contexto, fuentes primarias y términos importantes antes de construir tu propio cuaderno.',
  },
  {
    task: 'Preparar un guion o artículo con fuentes',
    choice: 'Los dos',
    reason: 'Usa Perplexity para descubrir fuentes y NotebookLM para trabajar después con las que realmente importan.',
  },
  {
    task: 'Estudiar para una clase o examen',
    choice: 'NotebookLM',
    reason: 'Cuando el material viene de apuntes, capítulos o PDFs, NotebookLM suele ordenar mejor el repaso.',
  },
  {
    task: 'Comprobar una noticia o un dato reciente',
    choice: 'Perplexity',
    reason: 'Primero necesitas encontrar fuentes actuales. Luego puedes guardar las buenas y analizarlas aparte.',
  },
];

const workflow = [
  'Empieza en Perplexity si no tienes fuentes claras.',
  'Abre las fuentes importantes y descarta resultados flojos o secundarios.',
  'Lleva las fuentes buenas a NotebookLM cuando necesites estudiar, resumir o escribir con base documental.',
  'Antes de publicar o decidir, vuelve a las fuentes originales y comprueba los datos importantes.',
];

const sources = [
  { label: 'Web oficial de Gemini Notebook (antes NotebookLM)', href: 'https://notebook.google/' },
  { label: 'Planes y límites de Gemini Notebook - Ayuda de Google', href: 'https://support.google.com/gemininotebook/answer/16213268?hl=es' },
  { label: 'Límites de uso de Gemini Notebook - Ayuda de Google', href: 'https://support.google.com/gemininotebook/answer/17670842?hl=es' },
  { label: 'Aplicación móvil de Gemini Notebook - Ayuda de Google', href: 'https://support.google.com/gemininotebook/answer/16296687?hl=es' },
  { label: 'Privacidad y términos de NotebookLM - Ayuda de Google', href: 'https://support.google.com/notebooklm/answer/17004255?hl=en' },
  { label: 'Qué plan de Perplexity elegir (plan gratis, Pro, Max) - Centro de ayuda', href: 'https://www.perplexity.ai/help-center/en/articles/11187416-which-perplexity-subscription-plan-is-right-for-you' },
  { label: 'Qué es Perplexity Pro - Centro de ayuda', href: 'https://www.perplexity.ai/help-center/en/articles/10352901-what-is-perplexity-pro' },
];

const faq = [
  {
    question: '¿Qué es mejor, NotebookLM o Perplexity?',
    answer: 'Depende de si ya tienes las fuentes. NotebookLM es mejor para trabajar con documentos que tú subes (PDF, notas, enlaces). Perplexity es mejor para buscar en la web y encontrar fuentes con sus enlaces. Lo práctico es usar Perplexity para encontrar material y NotebookLM para estudiarlo.',
  },
  {
    question: '¿NotebookLM y Perplexity son gratis?',
    answer: 'Los dos tienen plan gratis. NotebookLM (Gemini Notebook) se usa sin pagar con una cuenta de Google: hasta 100 cuadernos y 50 fuentes por cuaderno; los planes Google AI Plus, Pro y Ultra suben esos límites. El plan gratis de Perplexity incluye 3 búsquedas Pro al día, 1 consulta de investigación al mes y subida de archivos limitada. Datos de sus centros de ayuda, consultados en octubre de 2026.',
  },
  {
    question: '¿NotebookLM ahora se llama Gemini Notebook?',
    answer: 'Sí. Google lo ha renombrado Gemini Notebook y la dirección notebooklm.google lleva ahora a notebook.google. Es la misma herramienta: cuadernos con tus fuentes, resúmenes, preguntas y resúmenes en audio.',
  },
  {
    question: '¿NotebookLM funciona en español?',
    answer: 'Sí. Según la ayuda de Google, Gemini Notebook admite más de 80 idiomas y su aplicación móvil (Android 10 o posterior, iPhone y iPad) está en español de España, de Latinoamérica y de México. La aplicación se está lanzando poco a poco y todavía no hace todo lo que hace la web.',
  },
  {
    question: '¿Cuál conviene para estudiar?',
    answer: 'NotebookLM, porque trabaja sobre tus materiales: apuntes, capítulos en PDF, enlaces y transcripciones. Perplexity sirve antes, para encontrar lecturas sobre un tema que aún no conoces.',
  },
];


const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  pubDate="2026-07-08"
  modifiedDate="2026-10-29"
  keywords={['NotebookLM vs Perplexity', 'NotebookLM', 'Gemini Notebook', 'Perplexity', 'investigación IA', 'herramientas IA']}
  section="Herramientas IA"
  citations={sources.map((source) => source.href)}
>
  <article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <nav class="mb-8 text-sm text-dark-300" aria-label="Migas de pan">
      <a href="/herramientas/" class="text-brand-300 hover:text-brand-200">Herramientas IA</a>
      <span class="mx-2">/</span>
      <span>NotebookLM vs Perplexity</span>
    </nav>

    <header class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Comparativa práctica
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          NotebookLM vs Perplexity: cuál usar para investigar
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-dark-200">
          Perplexity es mejor para descubrir fuentes. NotebookLM (que Google ha renombrado Gemini Notebook) es mejor para trabajar con fuentes que ya has elegido. Los dos tienen plan gratis. La decisión práctica es sencilla: primero encuentra buen material, luego conviértelo en conocimiento útil.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/blog/notebooklm-guia-2026/" class="inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">Guía de NotebookLM</a>
          <a href="/herramientas/perplexity/" class="inline-flex rounded-lg border border-brand-700 px-4 py-2.5 text-sm font-semibold text-brand-300 transition hover:bg-dark-800">Ver ficha Perplexity</a>
        </div>
      </div>

      <aside class="rounded-lg border border-dark-600 bg-dark-800 p-5">
        <h2 class="font-display text-xl font-bold text-white">Decisión rápida</h2>
        <dl class="mt-4 grid gap-4 text-sm leading-6">
          <div>
            <dt class="font-semibold text-brand-300">Encontrar fuentes</dt>
            <dd class="mt-1 text-dark-200">Perplexity</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-300">Trabajar tus fuentes</dt>
            <dd class="mt-1 text-dark-200">NotebookLM</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-300">Flujo ideal</dt>
            <dd class="mt-1 text-dark-200">Perplexity para descubrir, NotebookLM para profundizar.</dd>
          </div>
        </dl>
        <a href="#newsletter" class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
          Recibir el filtro
        </a>
      </aside>
    </header>

    <section class="prose prose-invert mt-12 max-w-none text-dark-200">
      <h2>Veredicto Decodifica</h2>
      <p>
        Si estás empezando desde cero, abre Perplexity. Si ya tienes material fiable, abre NotebookLM. La combinación buena es usar Perplexity como radar y NotebookLM como mesa de trabajo.
      </p>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      {decisions.map((block) => (
        <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
          <h2 class="font-display text-2xl font-bold text-white">{block.title}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Comparativa por criterio</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full border-separate border-spacing-0 text-left text-sm">
          <thead>
            <tr class="text-xs uppercase text-dark-300">
              <th class="border-b border-dark-600 px-3 py-3">Criterio</th>
              <th class="border-b border-dark-600 px-3 py-3">NotebookLM</th>
              <th class="border-b border-dark-600 px-3 py-3">Perplexity</th>
              <th class="border-b border-dark-600 px-3 py-3">Mejor opción</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="align-top text-dark-200">
                <th class="border-b border-dark-700 px-3 py-4 font-semibold text-white">{row.criterion}</th>
                <td class="border-b border-dark-700 px-3 py-4 leading-6">{row.notebooklm}</td>
                <td class="border-b border-dark-700 px-3 py-4 leading-6">{row.perplexity}</td>
                <td class="border-b border-dark-700 px-3 py-4 font-semibold text-brand-300">{row.winner}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Qué abrir primero según la tarea</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {useCases.map((item) => (
          <div class="rounded-lg border border-dark-600 bg-dark-900 p-4">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-display text-lg font-bold text-white">{item.task}</h3>
              <span class="rounded-lg bg-brand-500/10 px-2.5 py-1 text-xs font-semibold text-brand-300">{item.choice}</span>
            </div>
            <p class="mt-2 text-sm leading-6 text-dark-200">{item.reason}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Flujo recomendado</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-4">
        {workflow.map((step, index) => (
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200">
            <span class="text-xs font-semibold text-brand-300">Paso {index + 1}</span>
            <p class="mt-1">{step}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Precio y límites</h2>
        <p class="mt-4 text-sm leading-6 text-dark-200">
          NotebookLM (Gemini Notebook) es gratis con una cuenta de Google: hasta 100 cuadernos y 50 fuentes por cuaderno, con un uso que se renueva cada 5 horas hasta un límite semanal. Google AI Plus da el doble, AI Pro cuatro veces más y AI Ultra entre 5 y 20 veces lo de Pro. El plan gratis de Perplexity da 3 búsquedas Pro al día y 1 consulta de investigación al mes; Pro y Max tienen límites más altos. El precio de Perplexity Pro no se pudo comprobar en su web: míralo en perplexity.ai/pro antes de pagar. Consultado en octubre de 2026.
        </p>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Privacidad</h2>
        <p class="mt-4 text-sm leading-6 text-dark-200">
          En NotebookLM el riesgo principal está en que subes material propio. En Perplexity, el riesgo aparece si metes datos privados en una herramienta pensada para investigar la web pública. En los dos casos: no subas material sensible sin revisar cuenta, plan, feedback, retención y política aplicable.
        </p>
      </div>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Sigue leyendo</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          <li><a href="/blog/notebooklm-guia-2026/" class="text-brand-300 hover:text-brand-200">NotebookLM (Gemini Notebook): qué es y cómo usarlo</a>, paso a paso y con sus límites.</li>
          <li><a href="/blog/alternativas-gratis-chatgpt-2026/" class="text-brand-300 hover:text-brand-200">Alternativas gratis a ChatGPT</a>, si buscas un asistente general sin pagar.</li>
          <li><a href="/herramientas/chatgpt-vs-claude/" class="text-brand-300 hover:text-brand-200">ChatGPT vs Claude: cuál elegir</a>, para redactar y razonar sobre lo que ya has investigado.</li>
          <li><a href="/blog/2026-07-26-arena-ai-modelos-gratis/" class="text-brand-300 hover:text-brand-200">Arena AI</a>, para comparar modelos a ciegas con tu propia tarea.</li>
        </ul>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Fuentes</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          {sources.map((source) => (
            <li><a href={source.href} target="_blank" rel="noopener" class="text-brand-300 hover:text-brand-200">{source.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Preguntas frecuentes</h2>
      <div class="mt-5 grid gap-4">
        {faq.map((item) => (
          <details class="rounded-lg border border-dark-600 bg-dark-900 p-4">
            <summary class="cursor-pointer font-semibold text-white">{item.question}</summary>
            <p class="mt-3 text-sm leading-6 text-dark-200">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-brand-500/30 bg-dark-800 p-6">
      <p class="text-sm font-semibold text-brand-300">Recurso Decodifica</p>
      <h2 class="mt-2 font-display text-2xl font-bold text-white">Si aún no sabes por dónde empezar</h2>
      <p class="mt-3 text-sm leading-6 text-dark-200">
        Abre el mapa de herramientas IA y elige la primera herramienta por tarea, riesgo y tipo de resultado.
      </p>
      <a href="/recursos/mapa-herramientas-ia/" class="mt-5 inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
        Abrir el mapa
      </a>
    </section>

    <div id="newsletter" class="mt-12">
      <NewsletterForm
        title="Recibe comparativas sin ruido"
        description="Una vez por semana: qué herramienta merece probar, cuál evitar y qué revisar antes de pagar o subir datos."
        buttonLabel="Recibir el filtro"
      />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Herramientas IA',
        item: `${siteConfig.url}/herramientas/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'NotebookLM vs Perplexity',
        item: pageUrl,
      },
    ],
  })} />
</BaseLayout>
