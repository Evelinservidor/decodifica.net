---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { siteConfig } from '~/lib/site-config';

const pageUrl = `${siteConfig.url}/herramientas/gamma-vs-canva-ai/`;
const title = 'Gamma vs Canva: cuál es mejor y qué da gratis cada una';
const description = 'Gamma crea la presentación desde un texto y Canva la diseña con tu marca. Qué da gratis cada una, si funcionan en español y cuál elegir según la tarea.';

const rows = [
  {
    criterion: 'Crear desde una idea',
    gamma: 'Muy fuerte para convertir un prompt, esquema o documento en una presentación o página visual inicial.',
    canva: 'Puede generar y editar, pero su ventaja aparece más cuando ya estás trabajando dentro de formatos visuales concretos.',
    winner: 'Gamma',
  },
  {
    criterion: 'Control visual y marca',
    gamma: 'Suficiente para borradores y piezas limpias, pero menos natural si necesitas un sistema visual amplio.',
    canva: 'Mejor para plantillas, brand kits, formatos de redes, materiales repetibles y adaptaciones visuales.',
    winner: 'Canva AI',
  },
  {
    criterion: 'Presentaciones',
    gamma: 'Gana para pasar de una idea a una presentación rápida y con narrativa visual.',
    canva: 'Gana si necesitas editar mucho el estilo, adaptar la pieza a marca o reutilizar elementos de diseño.',
    winner: 'Depende del momento',
  },
  {
    criterion: 'Redes y piezas de marketing',
    gamma: 'Puede generar contenido para redes, pero no es su punto fuerte.',
    canva: 'Muy fuerte para formatos de redes, banners, miniaturas, carruseles y piezas reutilizables.',
    winner: 'Canva AI',
  },
  {
    criterion: 'Documentos visuales',
    gamma: 'Buen encaje para documentos de una página, informes, páginas web sencillas y documentos visuales estructurados.',
    canva: 'Buen encaje si quieres una pieza más diseñada y ligada a marca o plantilla.',
    winner: 'Empate según salida',
  },
  {
    criterion: 'Privacidad y equipos',
    gamma: 'Revisa plan, workspace, archivos subidos y permisos antes de usar información sensible.',
    canva: 'Ofrece controles de IA y permisos por plan; aun así, revisa contenido, marca y datos de cliente antes de subirlos.',
    winner: 'Revisar plan',
  },
];

const decisions = [
  {
    title: 'Elige Gamma si...',
    items: [
      'Tienes una idea, texto o esquema y quieres convertirlo rápido en presentación o documento visual.',
      'Necesitas ordenar una propuesta antes de entrar en diseño fino.',
      'Quieres generar varias estructuras de presentación para comparar enfoques.',
      'La velocidad del primer borrador importa más que el control píxel a píxel.',
    ],
  },
  {
    title: 'Elige Canva AI si...',
    items: [
      'Necesitas piezas visuales listas para redes, marketing o marca.',
      'Quieres adaptar una idea a varios formatos: presentación, post, banner, miniatura o carrusel.',
      'Trabajas con plantillas, brand kits o materiales recurrentes.',
      'La edición visual y la consistencia de marca pesan más que el primer borrador.',
    ],
  },
];

const useCases = [
  {
    task: 'Tengo una idea y necesito una presentación inicial',
    choice: 'Gamma',
    reason: 'Empieza con Gamma para convertir el concepto en estructura visual y narrativa.',
  },
  {
    task: 'Tengo que publicar piezas en redes',
    choice: 'Canva AI',
    reason: 'Canva encaja mejor con formatos, plantillas, marca y adaptaciones visuales recurrentes.',
  },
  {
    task: 'Tengo una propuesta comercial',
    choice: 'Gamma primero, Canva después',
    reason: 'Usa Gamma para ordenar el argumento y Canva si necesitas pulir marca, portada o piezas derivadas.',
  },
  {
    task: 'Tengo identidad visual estricta',
    choice: 'Canva AI',
    reason: 'Si la marca manda, necesitas plantillas, controles visuales y materiales reutilizables.',
  },
  {
    task: 'Quiero un documento visual para explicar una idea',
    choice: 'Gamma',
    reason: 'Gamma es muy cómodo para documentos de una página y páginas visuales que nacen de un texto.',
  },
];

const workflow = [
  'Empieza por el objetivo: vender, explicar, presentar o publicar.',
  'Usa Gamma si necesitas estructura y narrativa desde texto.',
  'Usa Canva si necesitas adaptar, maquetar y mantener marca.',
  'Antes de publicar, revisa datos, derechos de recursos, legibilidad móvil y exportación final.',
];

const sources = [
  { label: 'Planes de Gamma: Free, Plus, Pro, Ultra y Business (centro de ayuda de Gamma)', href: 'https://help.gamma.app/en/articles/8077107-how-can-i-upgrade-my-gamma-subscription' },
  { label: 'Cómo funcionan los créditos en Gamma (centro de ayuda de Gamma)', href: 'https://help.gamma.app/en/articles/7834324-how-do-credits-work-in-gamma' },
  { label: 'Usar Gamma en tu idioma (centro de ayuda de Gamma)', href: 'https://help.gamma.app/en/articles/11016506-how-do-i-use-gamma-in-my-preferred-language' },
  { label: 'Traducir una presentación en Gamma (centro de ayuda de Gamma)', href: 'https://help.gamma.app/en/articles/11016513-can-i-translate-a-gamma-document' },
  { label: 'Planes y precios de Canva', href: 'https://www.canva.com/es_es/precios/' },
  { label: 'Cuánto uso de IA da cada plan de Canva (ayuda de Canva)', href: 'https://www.canva.com/help/ai-access/' },
];

const faq = [
  {
    question: '¿Qué es mejor, Gamma o Canva?',
    answer: 'Depende de en qué punto estés. Gamma es mejor para sacar la primera versión de una presentación o un documento a partir de una idea, unas notas o un texto. Canva es mejor para darle tu diseño y tu marca, y para adaptar la misma idea a redes, carteles o vídeos. Muchas veces conviene usar las dos: Gamma para ordenar el contenido y Canva para pulir el diseño.',
  },
  {
    question: '¿Gamma es gratis?',
    answer: 'Tiene un plan gratis sin límite de tiempo y sin tarjeta. Al registrarte recibes 400 créditos, que se gastan cada vez que usas la IA (crear una presentación, editar con el agente, generar imágenes) y no se renuevan: para tener más hay que invitar a otras personas (200 créditos por cada una) o pagar. Con el plan gratis, cada presentación generada tiene como máximo 10 diapositivas y, al compartirla o exportarla, lleva la marca «Made with Gamma». Lo que haces a mano (escribir, mover, cambiar el tema) no gasta créditos. Datos de su centro de ayuda, consultados el 05-11-2026.',
  },
  {
    question: '¿Canva tiene IA gratis para hacer presentaciones?',
    answer: 'Sí, pero limitada. Canva Gratis da «acceso limitado» a sus herramientas de IA estándar y premium, entre ellas generar un diseño con Canva AI, con un saldo mensual que comparten todas. Canva Pro tiene 10 veces más uso de IA que el plan gratis y Canva Business, 20 veces más. Cuando se acaba el saldo del plan gratis, la IA sigue funcionando con pausas entre una petición y otra. Datos de la página de precios y la ayuda de Canva, consultados el 05-11-2026.',
  },
  {
    question: '¿Gamma está en español?',
    answer: 'Sí. La interfaz se pone sola en el idioma del navegador (también se cambia en los ajustes de usuario) y su centro de ayuda tiene versión en español. Para que la presentación salga en español, escribe el prompt o las notas en español, o pide en el prompt el idioma que quieres. También puede traducir una presentación ya hecha, diapositiva a diapositiva o entera, gastando créditos.',
  },
  {
    question: '¿Tiene sentido usar las dos?',
    answer: 'Sí. Un flujo práctico es crear la estructura y el texto en Gamma y llevar después la portada, las imágenes de marca y las piezas para redes a Canva. Antes de pagar ninguna, prueba el plan gratis de las dos con la misma presentación.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  pubDate="2026-07-08"
  modifiedDate="2026-11-05"
  keywords={['Gamma vs Canva', 'Gamma o Canva', 'Gamma app gratis', 'Canva IA presentaciones', 'presentaciones con IA']}
  section="Herramientas IA"
  citations={sources.map((source) => source.href)}
>
  <article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <nav class="mb-8 text-sm text-dark-300" aria-label="Migas de pan">
      <a href="/herramientas/" class="text-brand-300 hover:text-brand-200">Herramientas IA</a>
      <span class="mx-2">/</span>
      <span>Gamma vs Canva AI</span>
    </nav>

    <header class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Comparativa práctica
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          Gamma vs Canva AI: cuál usar para presentaciones y diseño
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-dark-200">
          Gamma es mejor para convertir una idea en una presentación o documento visual. Canva AI es mejor para producir, adaptar y mantener piezas visuales con marca. Las dos tienen plan gratis con la IA limitada: Gamma da 400 créditos que no se renuevan y Canva, un saldo mensual limitado. No compiten siempre por la misma fase: muchas veces se complementan.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/herramientas/gamma/" class="inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">Ver ficha Gamma</a>
          <a href="/blog/ia-crea-presentaciones-completas/" class="inline-flex rounded-lg border border-brand-700 px-4 py-2.5 text-sm font-semibold text-brand-300 transition hover:bg-dark-800">Otras IA para presentaciones</a>
        </div>
      </div>

      <aside class="rounded-lg border border-dark-600 bg-dark-800 p-5">
        <h2 class="font-display text-xl font-bold text-white">Decisión rápida</h2>
        <dl class="mt-4 grid gap-4 text-sm leading-6">
          <div>
            <dt class="font-semibold text-brand-300">Primer borrador</dt>
            <dd class="mt-1 text-dark-200">Gamma</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-300">Marca y formatos</dt>
            <dd class="mt-1 text-dark-200">Canva AI</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-300">Flujo ideal</dt>
            <dd class="mt-1 text-dark-200">Gamma para estructurar, Canva para pulir y distribuir.</dd>
          </div>
        </dl>
        <a href="#newsletter" class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
          Recibir el filtro
        </a>
      </aside>
    </header>

    <section class="prose prose-invert mt-12 max-w-none text-dark-200">
      <h2>Veredicto Decodifica</h2>
      <p>
        Si la tarea empieza con una idea en bruto, abre Gamma. Si la tarea termina en una pieza visual publicable, abre Canva. Para propuestas y presentaciones importantes, el flujo más sensato es generar estructura en Gamma y terminar con criterio visual en Canva.
      </p>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      {decisions.map((block) => (
        <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
          <h2 class="font-display text-2xl font-bold text-white">{block.title}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Comparativa por criterio</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full border-separate border-spacing-0 text-left text-sm">
          <thead>
            <tr class="text-xs uppercase text-dark-300">
              <th class="border-b border-dark-600 px-3 py-3">Criterio</th>
              <th class="border-b border-dark-600 px-3 py-3">Gamma</th>
              <th class="border-b border-dark-600 px-3 py-3">Canva AI</th>
              <th class="border-b border-dark-600 px-3 py-3">Mejor opción</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="align-top text-dark-200">
                <th class="border-b border-dark-700 px-3 py-4 font-semibold text-white">{row.criterion}</th>
                <td class="border-b border-dark-700 px-3 py-4 leading-6">{row.gamma}</td>
                <td class="border-b border-dark-700 px-3 py-4 leading-6">{row.canva}</td>
                <td class="border-b border-dark-700 px-3 py-4 font-semibold text-brand-300">{row.winner}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Qué abrir primero según la tarea</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {useCases.map((item) => (
          <div class="rounded-lg border border-dark-600 bg-dark-900 p-4">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-display text-lg font-bold text-white">{item.task}</h3>
              <span class="rounded-lg bg-brand-500/10 px-2.5 py-1 text-xs font-semibold text-brand-300">{item.choice}</span>
            </div>
            <p class="mt-2 text-sm leading-6 text-dark-200">{item.reason}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Flujo recomendado</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-4">
        {workflow.map((step, index) => (
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200">
            <span class="text-xs font-semibold text-brand-300">Paso {index + 1}</span>
            <p class="mt-1">{step}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Precio y límites</h2>
        <p class="mt-4 text-sm leading-6 text-dark-200 [&_strong]:text-white">
          <strong>Gamma</strong> funciona con créditos. El plan gratis da 400 al registrarte, que no se renuevan, y genera presentaciones de hasta 10 diapositivas que llevan la marca «Made with Gamma» al compartirlas o exportarlas. Los planes de pago (Plus, Pro, Ultra y Business) renuevan los créditos cada mes: Plus da 1.500 y Pro, 4.000; los dos quitan la marca y generan hasta 100 diapositivas. El precio de cada plan no se pudo comprobar (su página de precios no se deja leer a programas automáticos): míralo en gamma.app/pricing. <strong>Canva</strong> tiene plan gratis con acceso limitado a su IA; Pro da 10 veces más uso de IA y Business, 20 veces más. Su página de precios mostraba, en dólares y sin impuestos, 144 US$ al año por persona en Pro y 250 US$ en Business (consultada el 05-11-2026 desde fuera de España: mira el precio de tu país en canva.com).
        </p>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Privacidad</h2>
        <p class="mt-4 text-sm leading-6 text-dark-200">
          En estas herramientas el riesgo suele estar en subir propuestas, datos de clientes, logos, imágenes o material de marca. Canva publica controles de IA y permisos por plan; Gamma también debe revisarse por workspace, archivos y permisos. Si hay datos sensibles, usa material anonimizado para el borrador.
        </p>
      </div>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Sigue leyendo</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
          <li><a href="/blog/ia-crea-presentaciones-completas/" class="text-brand-300 hover:text-brand-200">IA para crear presentaciones completas</a>: Gamma, Canva, Beautiful.ai y otras, con sus precios.</li>
          <li><a href="/herramientas/gamma/" class="text-brand-300 hover:text-brand-200">Ficha de Gamma</a>, cuándo usarla y cuándo no.</li>
          <li><a href="/herramientas/kimi/" class="text-brand-300 hover:text-brand-200">Kimi IA</a>, que también crea presentaciones editables (.pptx).</li>
          <li><a href="/herramientas/generador-prompts/" class="text-brand-300 hover:text-brand-200">Generador de prompts</a>, para escribir el encargo que le das a Gamma o a Canva.</li>
        </ul>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Fuentes</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          {sources.map((source) => (
            <li><a href={source.href} target="_blank" rel="noopener" class="text-brand-300 hover:text-brand-200">{source.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Preguntas frecuentes</h2>
      <div class="mt-5 grid gap-4">
        {faq.map((item) => (
          <details class="rounded-lg border border-dark-600 bg-dark-900 p-4">
            <summary class="cursor-pointer font-semibold text-white">{item.question}</summary>
            <p class="mt-3 text-sm leading-6 text-dark-200">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-brand-500/30 bg-dark-800 p-6">
      <p class="text-sm font-semibold text-brand-300">Recurso Decodifica</p>
      <h2 class="mt-2 font-display text-2xl font-bold text-white">Si aún no sabes por dónde empezar</h2>
      <p class="mt-3 text-sm leading-6 text-dark-200">
        Abre el mapa de herramientas IA y elige la primera herramienta por tarea, riesgo y tipo de resultado.
      </p>
      <a href="/recursos/mapa-herramientas-ia/" class="mt-5 inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
        Abrir el mapa
      </a>
    </section>

    <div id="newsletter" class="mt-12">
      <NewsletterForm
        title="Recibe comparativas sin ruido"
        description="Una vez por semana: qué herramienta merece probar, cuál evitar y qué revisar antes de pagar o subir datos."
        buttonLabel="Recibir el filtro"
      />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Herramientas IA',
        item: `${siteConfig.url}/herramientas/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Gamma vs Canva AI',
        item: pageUrl,
      },
    ],
  })} />
</BaseLayout>
