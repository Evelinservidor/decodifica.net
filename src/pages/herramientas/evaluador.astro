---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { tools } from '~/data/tools';
---

<BaseLayout title="Evaluador de resultados de IA" description="Puntúa un resultado de IA por exactitud, trazabilidad, ahorro, edición, privacidad y repetibilidad para decidir si conservar el flujo.">
  <main class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8"><header class="max-w-4xl"><p class="inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">Ficha de prueba reutilizable</p><h1 class="mt-5 font-display text-4xl font-bold sm:text-5xl">¿La herramienta te sirvió de verdad?</h1><p class="mt-5 text-lg leading-8 text-dark-200">Puntúa una prueba real del 1 al 5. El cálculo ocurre en tu navegador y no guarda el contenido de la tarea.</p></header>
    <form id="score-form" class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6"><label class="block"><span class="font-semibold">Herramienta evaluada</span><select id="score-tool" required class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3"><option value="">Selecciona</option>{tools.map((tool)=><option value={tool.slug}>{tool.name}</option>)}</select></label><div class="mt-6 grid gap-4">{[
      ['accuracy','Exactitud','La salida coincide con hechos y resultado esperado.'],['traceability','Trazabilidad','Puedes volver a fuentes, datos o pasos.'],['time','Ahorro real','Ahorra tiempo después de contar revisión y correcciones.'],['editing','Poca edición','Necesita pocos cambios para poder usarse.'],['privacy','Privacidad','El flujo usa datos y permisos apropiados.'],['repeatability','Repetibilidad','Otra persona podría repetirlo con la misma calidad.']
    ].map(([id,label,help])=><label class="rounded-lg bg-dark-900 p-4"><span class="flex items-center justify-between gap-4"><span><strong class="text-white">{label}</strong><small class="mt-1 block text-dark-300">{help}</small></span><output id={`${id}-value`} class="text-xl font-bold text-brand-300">3</output></span><input id={`score-${id}`} type="range" min="1" max="5" value="3" class="mt-4 w-full" /></label>)}</div><button class="mt-6 rounded-lg bg-brand-500 px-5 py-3 font-semibold text-white">Calcular decisión</button><p id="score-error" class="mt-3 hidden text-sm text-red-300" role="alert">Selecciona una herramienta.</p></form>
    <section id="score-result" hidden class="mt-8 rounded-lg border border-brand-500/30 bg-dark-800 p-6" aria-live="polite"><p id="score-number" class="text-sm font-semibold text-brand-300"></p><h2 id="score-title" class="mt-2 font-display text-3xl font-bold"></h2><p id="score-summary" class="mt-4 leading-7 text-dark-200"></p><div id="score-details" class="mt-6 grid gap-3 md:grid-cols-3"></div><div class="mt-6 flex flex-wrap gap-3"><button id="score-print" type="button" class="rounded-lg border border-dark-600 px-4 py-2.5 font-semibold">Imprimir ficha</button><a id="score-tool-link" href="/herramientas/" class="rounded-lg bg-brand-500 px-4 py-2.5 font-semibold text-white">Abrir ficha</a></div></section>
  </main>
  <script>
    const dimensions=['accuracy','traceability','time','editing','privacy','repeatability'];
    const scoreTool=document.querySelector('#score-tool');
    const initialTool=new URLSearchParams(window.location.search).get('tool');
    if(initialTool && scoreTool && Array.from(scoreTool.options).some((option)=>option.value===initialTool)) scoreTool.value=initialTool;
    dimensions.forEach((id)=>document.querySelector(`#score-${id}`)?.addEventListener('input',(event)=>document.querySelector(`#${id}-value`).textContent=event.target.value));
    document.querySelector('#score-form')?.addEventListener('submit',(event)=>{event.preventDefault(); const tool=document.querySelector('#score-tool')?.value; if(!tool){document.querySelector('#score-error')?.classList.remove('hidden');return;} document.querySelector('#score-error')?.classList.add('hidden'); const scores=dimensions.map((id)=>Number(document.querySelector(`#score-${id}`)?.value)); const average=scores.reduce((a,b)=>a+b,0)/scores.length; const decision=average>=4?['Conservar el flujo','La prueba es suficientemente sólida para documentarla y repetirla, manteniendo revisión.']:average>=3?['Repetir la prueba','Hay valor, pero antes de convertirlo en hábito corrige las dimensiones más débiles.']:['Descartar o cambiar el flujo','La edición, el riesgo o la falta de trazabilidad pesan más que el beneficio.']; document.querySelector('#score-number').textContent=`Puntuación ${average.toFixed(1)} / 5`; document.querySelector('#score-title').textContent=decision[0]; document.querySelector('#score-summary').textContent=decision[1]; const details=document.querySelector('#score-details'); details.replaceChildren(...dimensions.map((id,index)=>{const div=document.createElement('div');div.className='rounded-lg bg-dark-900 p-4 text-sm text-dark-200';div.textContent=`${document.querySelector(`#score-${id}`)?.closest('label')?.querySelector('strong')?.textContent}: ${scores[index]}/5`;return div;})); document.querySelector('#score-tool-link').href=`/herramientas/${tool}/`; document.querySelector('#score-result').hidden=false; document.querySelector('#score-result').scrollIntoView({behavior:'smooth'}); window.DecodificaTrack?.emit?.('utility_complete',{component:'result_evaluator',tool,decision:average>=4?'keep':average>=3?'retry':'discard'}); });
    document.querySelector('#score-print')?.addEventListener('click',()=>{window.print();window.DecodificaTrack?.emit?.('utility_print',{component:'result_evaluator'});});
  </script>
</BaseLayout>
