---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { getToolBySlug } from '~/data/tools';
import { siteConfig } from '~/lib/site-config';

const chatgpt = getToolBySlug('chatgpt');
const claude = getToolBySlug('claude');

const pageUrl = `${siteConfig.url}/herramientas/chatgpt-vs-claude/`;
const title = 'ChatGPT vs Claude: cual elegir';
const description = 'Comparativa practica entre ChatGPT y Claude: escritura, documentos, codigo, privacidad, precio y que usar segun la tarea.';

const rows = [
  {
    criterion: 'Uso general',
    chatgpt: 'Mejor punto de entrada si quieres una herramienta para casi todo: escribir, resumir, razonar, programar y desbloquear tareas abiertas.',
    claude: 'Muy fuerte, pero brilla mas cuando la tarea esta centrada en texto, documentos largos o instrucciones cuidadas.',
    winner: 'ChatGPT',
  },
  {
    criterion: 'Escritura larga',
    chatgpt: 'Funciona bien para borradores, estructura y reescritura, especialmente si iteras varias veces.',
    claude: 'Suele ser mas comodo para documentos largos, tono cuidado, emails y textos donde el matiz importa.',
    winner: 'Claude',
  },
  {
    criterion: 'Documentos y contexto',
    chatgpt: 'Buen asistente para resumir y transformar documentos, con valor extra si ya usas su ecosistema.',
    claude: 'Una opcion especialmente fuerte cuando el trabajo gira alrededor de archivos, contexto extenso y revision de texto.',
    winner: 'Claude',
  },
  {
    criterion: 'Codigo',
    chatgpt: 'Buen copiloto general para explicar errores, crear scripts, revisar codigo y proponer soluciones.',
    claude: 'Muy competitivo para explicar, refactorizar y razonar sobre codigo, sobre todo cuando hay contexto largo.',
    winner: 'Empate segun flujo',
  },
  {
    criterion: 'Privacidad de empresa',
    chatgpt: 'OpenAI declara que no entrena por defecto con datos de ChatGPT Business, Enterprise, Edu, Healthcare, Teachers ni API.',
    claude: 'Anthropic separa productos de consumo y comerciales; sus politicas de retencion dependen del producto y acuerdo.',
    winner: 'Revisar plan',
  },
  {
    criterion: 'Precio',
    chatgpt: 'Tiene plan gratuito y planes de pago para usuarios, equipos y empresa. Los limites y funciones cambian por plan.',
    claude: 'Tiene Free, Pro, Max y planes de trabajo/equipo. Pro se situa en el rango de pago individual habitual.',
    winner: 'Depende del uso',
  },
];

const decisions = [
  {
    title: 'Elige ChatGPT si...',
    items: [
      'Quieres una herramienta principal para tareas variadas.',
      'Necesitas mezclar escritura, codigo, analisis, imagenes o trabajo general.',
      'No tienes claro todavia que herramienta especializada necesitas.',
      'Trabajas con equipos que ya usan el ecosistema de OpenAI.',
    ],
  },
  {
    title: 'Elige Claude si...',
    items: [
      'Tu trabajo principal son documentos largos, emails o escritura cuidada.',
      'Necesitas transformar mucho texto sin perder tono ni estructura.',
      'Quieres crear instrucciones reutilizables para procesos repetidos.',
      'Te importa especialmente el contexto largo y la revision de material textual.',
    ],
  },
];

const useCases = [
  {
    task: 'Escribir un email importante',
    choice: 'Claude',
    reason: 'Suele ser mejor cuando quieres sonar humano, ajustar tono y pulir el texto sin que parezca una plantilla.',
  },
  {
    task: 'Empezar una idea desde cero',
    choice: 'ChatGPT',
    reason: 'Es mas versatil para explorar opciones, generar esquemas y convertir una idea vaga en una primera accion.',
  },
  {
    task: 'Revisar un documento largo',
    choice: 'Claude',
    reason: 'Tiene mucho sentido cuando el centro de la tarea es leer, reorganizar y mejorar texto con contexto.',
  },
  {
    task: 'Resolver una duda de codigo',
    choice: 'Empate',
    reason: 'Prueba ambos con el mismo error: muchas veces gana el que mejor entienda tu contexto y restricciones.',
  },
  {
    task: 'Trabajar con datos sensibles',
    choice: 'Ninguno sin revisar plan',
    reason: 'Antes de subir datos privados, comprueba cuenta, plan, retencion, permisos y politica aplicable.',
  },
];

const sources = [
  { label: 'Planes oficiales de ChatGPT', href: 'https://chatgpt.com/pricing/' },
  { label: 'Precios de ChatGPT Business', href: 'https://openai.com/business/pricing/' },
  { label: 'Privacidad empresarial de OpenAI', href: 'https://openai.com/enterprise-privacy/' },
  { label: 'Planes oficiales de Claude', href: 'https://support.claude.com/en/articles/11049762-choose-a-claude-plan' },
  { label: 'Precios de Claude API', href: 'https://platform.claude.com/docs/en/about-claude/pricing' },
  { label: 'Retencion de datos de Claude', href: 'https://privacy.claude.com/en/articles/10023548-how-long-do-you-store-my-data' },
];

const faq = [
  {
    question: 'Es mejor ChatGPT o Claude?',
    answer: 'Para uso general, ChatGPT suele ser mejor punto de partida. Para escritura larga, documentos y tono cuidado, Claude suele ser una apuesta mas natural. La decision buena depende de la tarea, no del nombre del modelo.',
  },
  {
    question: 'Cual es mejor para escribir?',
    answer: 'Claude suele destacar en textos largos, emails y documentos donde el tono importa. ChatGPT tambien escribe bien, pero su ventaja esta en ser mas versatil para tareas mezcladas.',
  },
  {
    question: 'Cual conviene para datos sensibles?',
    answer: 'No subas datos sensibles a ningun chat sin revisar el plan, la configuracion y la politica de datos. En empresas, mira especificamente las condiciones de Business, Enterprise, Team o API.',
  },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: pageUrl,
  datePublished: '2026-07-07',
  dateModified: '2026-07-07',
  author: {
    '@type': 'Organization',
    name: 'Decodifica',
    url: siteConfig.url,
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  pubDate="2026-07-07"
  modifiedDate="2026-07-07"
  keywords={['ChatGPT vs Claude', 'ChatGPT', 'Claude', 'herramientas IA', 'comparativa IA']}
  section="Herramientas IA"
>
  <article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <nav class="mb-8 text-sm text-dark-300" aria-label="Migas de pan">
      <a href="/herramientas/" class="text-brand-300 hover:text-brand-200">Herramientas IA</a>
      <span class="mx-2">/</span>
      <span>ChatGPT vs Claude</span>
    </nav>

    <header class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Comparativa practica
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          ChatGPT vs Claude: cual elegir segun la tarea
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-dark-200">
          Si solo quieres una herramienta para casi todo, empieza por ChatGPT. Si tu trabajo gira alrededor de documentos, escritura larga y tono cuidado, Claude merece estar muy arriba. La clave no es elegir un ganador universal: es saber cual abrir primero.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/herramientas/chatgpt/" class="inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">Ver ficha ChatGPT</a>
          <a href="/herramientas/claude/" class="inline-flex rounded-lg border border-brand-700 px-4 py-2.5 text-sm font-semibold text-brand-300 transition hover:bg-dark-800">Ver ficha Claude</a>
        </div>
      </div>

      <aside class="rounded-lg border border-dark-600 bg-dark-800 p-5">
        <h2 class="font-display text-xl font-bold text-white">Decision rapida</h2>
        <dl class="mt-4 grid gap-4 text-sm leading-6">
          <div>
            <dt class="font-semibold text-brand-300">Uso general</dt>
            <dd class="mt-1 text-dark-200">ChatGPT</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-300">Escritura y documentos</dt>
            <dd class="mt-1 text-dark-200">Claude</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-300">Datos sensibles</dt>
            <dd class="mt-1 text-dark-200">Revisa plan y privacidad antes de subir nada.</dd>
          </div>
        </dl>
        <a href="#newsletter" class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
          Recibir el filtro
        </a>
      </aside>
    </header>

    <section class="prose prose-invert mt-12 max-w-none text-dark-200">
      <h2>Veredicto Decodifica</h2>
      <p>
        ChatGPT gana como herramienta principal para uso amplio. Claude gana cuando el resultado depende de leer, reescribir y cuidar textos largos. Si trabajas con contenido, documentos o emails, prueba Claude. Si quieres una navaja suiza para empezar cualquier tarea, ChatGPT es mas directo.
      </p>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      {decisions.map((block) => (
        <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
          <h2 class="font-display text-2xl font-bold text-white">{block.title}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-dark-200">
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Comparativa por criterio</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full border-separate border-spacing-0 text-left text-sm">
          <thead>
            <tr class="text-xs uppercase text-dark-300">
              <th class="border-b border-dark-600 px-3 py-3">Criterio</th>
              <th class="border-b border-dark-600 px-3 py-3">ChatGPT</th>
              <th class="border-b border-dark-600 px-3 py-3">Claude</th>
              <th class="border-b border-dark-600 px-3 py-3">Mejor opcion</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="align-top text-dark-200">
                <th class="border-b border-dark-700 px-3 py-4 font-semibold text-white">{row.criterion}</th>
                <td class="border-b border-dark-700 px-3 py-4 leading-6">{row.chatgpt}</td>
                <td class="border-b border-dark-700 px-3 py-4 leading-6">{row.claude}</td>
                <td class="border-b border-dark-700 px-3 py-4 font-semibold text-brand-300">{row.winner}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Que abrir primero segun la tarea</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {useCases.map((item) => (
          <div class="rounded-lg border border-dark-600 bg-dark-900 p-4">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-display text-lg font-bold text-white">{item.task}</h3>
              <span class="rounded-lg bg-brand-500/10 px-2.5 py-1 text-xs font-semibold text-brand-300">{item.choice}</span>
            </div>
            <p class="mt-2 text-sm leading-6 text-dark-200">{item.reason}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Precio y limites</h2>
        <p class="mt-4 text-sm leading-6 text-dark-200">
          Los dos tienen plan gratuito y planes de pago. ChatGPT organiza su oferta en planes personales, Business y Enterprise. Claude tiene Free, Pro, Max y planes para trabajo/equipo. En ambos casos, no decidas solo por el precio mensual: mira limites, funciones incluidas y el tipo de datos que vas a subir.
        </p>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Privacidad</h2>
        <p class="mt-4 text-sm leading-6 text-dark-200">
          La comparativa cambia mucho si hablamos de cuenta personal, plan de empresa o API. OpenAI declara que no entrena por defecto con datos de sus ofertas empresariales y API. Anthropic diferencia productos de consumo y comerciales, con politicas de retencion que dependen del caso. Si hay datos sensibles, revisa el plan antes de probar.
        </p>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Flujo recomendado para decidir</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-4">
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><span class="text-xs font-semibold text-brand-300">Paso 1</span><p class="mt-1">Elige una tarea real: email, documento, codigo o analisis.</p></li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><span class="text-xs font-semibold text-brand-300">Paso 2</span><p class="mt-1">Usa el mismo prompt en ChatGPT y Claude.</p></li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><span class="text-xs font-semibold text-brand-300">Paso 3</span><p class="mt-1">Compara salida, tiempo de edicion y errores.</p></li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><span class="text-xs font-semibold text-brand-300">Paso 4</span><p class="mt-1">Paga solo si esa tarea se repite cada semana.</p></li>
      </ol>
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Fichas relacionadas</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          {chatgpt && <li><a href={`/herramientas/${chatgpt.slug}/`} class="text-brand-300 hover:text-brand-200">{chatgpt.name}: cuando usarlo</a></li>}
          {claude && <li><a href={`/herramientas/${claude.slug}/`} class="text-brand-300 hover:text-brand-200">{claude.name}: cuando usarlo</a></li>}
          <li><a href="/herramientas/notebooklm/" class="text-brand-300 hover:text-brand-200">NotebookLM si trabajas con fuentes propias</a></li>
          <li><a href="/blog/claude-skills-desde-cero/" class="text-brand-300 hover:text-brand-200">Claude Skills desde cero</a></li>
        </ul>
      </div>
      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <h2 class="font-display text-2xl font-bold text-white">Fuentes</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6">
          {sources.map((source) => (
            <li><a href={source.href} target="_blank" rel="noopener" class="text-brand-300 hover:text-brand-200">{source.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <h2 class="font-display text-2xl font-bold text-white">Preguntas frecuentes</h2>
      <div class="mt-5 grid gap-4">
        {faq.map((item) => (
          <details class="rounded-lg border border-dark-600 bg-dark-900 p-4">
            <summary class="cursor-pointer font-semibold text-white">{item.question}</summary>
            <p class="mt-3 text-sm leading-6 text-dark-200">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <div id="newsletter" class="mt-12">
      <NewsletterForm
        title="Recibe comparativas sin ruido"
        description="Una vez por semana: que herramienta merece probar, cual evitar y que revisar antes de pagar o subir datos."
        buttonLabel="Recibir el filtro"
      />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Herramientas IA',
        item: `${siteConfig.url}/herramientas/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'ChatGPT vs Claude',
        item: pageUrl,
      },
    ],
  })} />
</BaseLayout>
