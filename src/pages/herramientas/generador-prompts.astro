---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
---

<BaseLayout title="Constructor de prompts útiles" description="Construye un prompt estructurado por tarea, contexto, resultado, restricciones y criterio de calidad sin usar IA ni enviar tus datos a una API.">
  <main class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
    <header class="max-w-4xl"><p class="inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">Constructor local · sin IA</p><h1 class="mt-5 font-display text-4xl font-bold sm:text-5xl">Construye un prompt que puedas revisar</h1><p class="mt-5 text-lg leading-8 text-dark-200">No llama a ningún modelo ni API. Un script ordena tu objetivo en una plantilla copiable y añade un control de calidad. El texto no sale de tu navegador.</p></header>
    <form id="prompt-form" class="mt-10 grid gap-6 rounded-lg border border-dark-600 bg-dark-800 p-6" novalidate>
      <div class="grid gap-5 md:grid-cols-2"><label><span class="font-semibold">Tarea</span><select id="prompt-task" required class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3"><option value="">Elige una tarea</option><option value="investigar">Investigar con fuentes</option><option value="resumir">Resumir un documento</option><option value="escribir">Redactar o reescribir</option><option value="analizar">Analizar datos</option><option value="planificar">Planificar trabajo</option><option value="codigo">Trabajar con código</option></select></label><label><span class="font-semibold">Formato de salida</span><select id="prompt-output" required class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3"><option value="">Elige un formato</option><option>tabla</option><option>lista de pasos</option><option>resumen ejecutivo</option><option>borrador editable</option><option>checklist</option><option>JSON válido</option></select></label></div>
      <label><span class="font-semibold">Resultado que necesitas</span><input id="prompt-goal" maxlength="240" required placeholder="Ej.: comparar tres presupuestos con los mismos criterios" class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3" /></label>
      <label><span class="font-semibold">Contexto mínimo</span><textarea id="prompt-context" maxlength="1200" rows="5" placeholder="Incluye solo el contexto necesario. No pegues datos sensibles." class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3"></textarea></label>
      <div class="grid gap-5 md:grid-cols-2"><label><span class="font-semibold">Audiencia</span><input id="prompt-audience" maxlength="120" placeholder="Ej.: responsable de compras de una pyme" class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3" /></label><label><span class="font-semibold">Restricciones</span><input id="prompt-rules" maxlength="240" placeholder="Ej.: no inventes precios; marca datos ausentes" class="mt-2 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-3" /></label></div>
      <label class="flex gap-3 rounded-lg border border-amber-300/25 bg-amber-300/5 p-4 text-sm text-dark-200"><input id="prompt-sources" type="checkbox" class="mt-1" /><span>La tarea necesita hechos o fuentes: exigir enlaces, citas o una marca visible de “no verificado”.</span></label>
      <button class="w-fit rounded-lg bg-brand-500 px-5 py-3 font-semibold text-white">Construir prompt</button><p id="prompt-error" class="hidden text-sm text-red-300" role="alert">Completa tarea, resultado y formato.</p>
    </form>
    <section id="prompt-result" hidden class="mt-8 rounded-lg border border-brand-500/30 bg-dark-800 p-6" aria-live="polite"><h2 class="font-display text-2xl font-bold">Prompt listo para adaptar</h2><pre class="mt-5 overflow-x-auto whitespace-pre-wrap rounded-lg bg-dark-900 p-5 text-sm leading-7"><code id="prompt-text"></code></pre><div class="mt-5 flex flex-wrap gap-3"><button id="prompt-copy" type="button" class="rounded-lg bg-brand-500 px-4 py-2.5 font-semibold">Copiar prompt</button><button id="prompt-print" type="button" class="rounded-lg border border-dark-600 px-4 py-2.5 font-semibold">Imprimir</button></div><h3 class="mt-8 font-display text-xl font-bold">Antes de usar la respuesta</h3><ul class="mt-4 grid gap-3 md:grid-cols-3 text-sm text-dark-200"><li class="rounded-lg bg-dark-900 p-4">Comprueba hechos, cifras y nombres.</li><li class="rounded-lg bg-dark-900 p-4">Marca supuestos y datos ausentes.</li><li class="rounded-lg bg-dark-900 p-4">Decide qué no debes delegar.</li></ul></section>
    <div class="mt-12"><NewsletterForm title="Recibe prompts que nacen de una tarea real" description="Plantillas, workflows y pruebas para pasar de prompt suelto a proceso revisable." buttonLabel="Recibir el filtro" /></div>
  </main>
  <script>
    const form=document.querySelector('#prompt-form'); const output=document.querySelector('#prompt-result'); const text=document.querySelector('#prompt-text'); const error=document.querySelector('#prompt-error');
    const value=(id)=>document.querySelector(id)?.value.trim() ?? '';
    async function copyText(value){try{if(!navigator.clipboard?.writeText)throw new Error('Clipboard API unavailable');await Promise.race([navigator.clipboard.writeText(value),new Promise((_,reject)=>setTimeout(()=>reject(new Error('Clipboard timeout')),1200))]);return true;}catch{const area=document.createElement('textarea');area.value=value;area.style.position='fixed';area.style.opacity='0';document.body.appendChild(area);area.select();const copied=document.execCommand('copy');area.remove();return copied;}}
    form?.addEventListener('submit',(event)=>{event.preventDefault(); const task=value('#prompt-task'); const goal=value('#prompt-goal'); const format=value('#prompt-output'); if(!task||!goal||!format){error?.classList.remove('hidden');return;} error?.classList.add('hidden'); const context=value('#prompt-context')||'[Añade el contexto mínimo necesario]'; const audience=value('#prompt-audience')||'[Indica quién usará el resultado]'; const rules=value('#prompt-rules')||'No inventes datos. Señala cualquier supuesto o información ausente.'; const sources=document.querySelector('#prompt-sources')?.checked ? 'Para cada afirmación factual, incluye la fuente exacta o marca “no verificado”.' : 'Separa hechos, supuestos e inferencias.'; text.textContent=`TAREA\n${goal}\n\nCONTEXTO\n${context}\n\nAUDIENCIA\n${audience}\n\nSALIDA\nEntrega el resultado como ${format}.\n\nRESTRICCIONES\n${rules}\n${sources}\n\nMÉTODO\n1. Resume primero cómo abordarás la tarea.\n2. Produce la salida solicitada.\n3. Añade una sección “Dudas y datos por comprobar”.\n4. Cierra con una checklist breve para revisar el resultado antes de usarlo.`; output.hidden=false; output.scrollIntoView({behavior:'smooth',block:'start'}); window.DecodificaTrack?.emit?.('utility_complete',{component:'prompt_builder',task,format}); });
    document.querySelector('#prompt-copy')?.addEventListener('click',async(event)=>{const copied=await copyText(text?.textContent ?? '');if(!copied&&text){const range=document.createRange();range.selectNodeContents(text);const selection=window.getSelection();selection?.removeAllRanges();selection?.addRange(range);}event.currentTarget.textContent=copied?'Copiado':'Texto seleccionado: Ctrl+C';if(copied)window.DecodificaTrack?.emit?.('utility_copy',{component:'prompt_builder'});});
    document.querySelector('#prompt-print')?.addEventListener('click',()=>{window.print(); window.DecodificaTrack?.emit?.('utility_print',{component:'prompt_builder'});});
  </script>
</BaseLayout>
