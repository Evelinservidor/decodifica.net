---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';

const pdfUrl = '/lead-magnets/50-prompts-ia.pdf';

const recursos = [
  {
    title: 'Reunión a decisiones y tareas',
    description: 'Workflow trazable para extraer acuerdos, responsables y fechas sin completar silencios de la transcripción.',
    type: 'Workflow', pages: 1, href: '/workflows/reunion-a-decisiones-y-tareas/', status: 'Disponible', version: '1.0', updated: '14/07/2026',
  },
  {
    title: 'Verificar una fórmula con IA',
    description: 'Workflow y ficha de prueba para corregir una hoja sin aceptar resultados plausibles a ciegas.',
    type: 'Workflow', pages: 1, href: '/workflows/verificar-formula-hoja-calculo/', status: 'Disponible', version: '1.0', updated: '14/07/2026',
  },
  {
    title: 'Investigar sin perder las fuentes',
    description: 'Proceso para separar búsqueda, selección, análisis y redacción con trazabilidad.',
    type: 'Workflow', pages: 1, href: '/workflows/investigar-con-fuentes/', status: 'Disponible', version: '1.0', updated: '14/07/2026',
  },
  {
    title: 'Prototipo de app revisable',
    description: 'Plantilla de alcance, prompt, prueba y límites para no confundir demo con producto.',
    type: 'Workflow', pages: 1, href: '/workflows/prototipo-app-revisable/', status: 'Disponible', version: '1.0', updated: '14/07/2026',
  },
  {
    title: 'Planificar la semana con control',
    description: 'Workflow para usar calendario y tareas sin delegar compromisos ni prioridades.',
    type: 'Workflow', pages: 1, href: '/workflows/planificar-semana-sin-ceder-prioridades/', status: 'Disponible', version: '1.0', updated: '14/07/2026',
  },
  {
    title: 'Mapa Decodifica de herramientas IA',
    description: 'Guía rápida para decidir qué IA abrir primero según la tarea: escribir, investigar, estudiar, programar, diseñar, presentar o crear voz.',
    type: 'Mapa',
    pages: 1,
    href: '/recursos/mapa-herramientas-ia/',
    status: 'Disponible',
    version: null,
    updated: null,
  },
  {
    title: '50 prompts para IA',
    description: 'Plantillas para escribir, investigar, resumir, planificar, aprender y trabajar mejor con ChatGPT, Claude o Gemini.',
    type: 'PDF',
    pages: 13,
    href: pdfUrl,
    status: 'Disponible',
    version: '1.1',
    updated: '10/07/2026',
  },
  {
    title: 'Workflows de IA para el día a día',
    description: 'Cinco flujos prácticos para convertir tareas repetidas en procesos con IA: email, planificación, análisis y aprendizaje.',
    type: 'PDF',
    pages: 8,
    href: '/lead-magnets/workflows-ia-dia-a-dia.pdf',
    status: 'Disponible',
    version: '1.1',
    updated: '10/07/2026',
  },
  {
    title: 'Mini curso: usar IA con más contexto',
    description: 'Cinco lecciones breves para pasar de prompts sueltos a un sistema de trabajo más estable.',
    type: 'Curso',
    pages: 5,
    href: '/newsletter/',
    status: 'Próximo envío',
    version: null,
    updated: null,
  },
];

const categorias = [
  'Prompts copiables',
  'Flujos de productividad',
  'Guías para elegir herramientas',
  'Material de apoyo de los vídeos',
];
---

<BaseLayout
  title="Recursos gratuitos de IA práctica"
  description="Biblioteca de recursos IA de Decodifica: prompts, workflows y guías prácticas para aplicar inteligencia artificial en tareas reales."
>
  <div class="page-shell mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <header class="page-hero grid gap-8 lg:grid-cols-[1fr_420px] lg:items-center">
      <div>
        <p class="eyebrow mb-4 inline-flex rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Recursos IA
        </p>
        <h1 class="text-balance font-display text-4xl font-bold leading-tight sm:text-5xl">
          Prompts, flujos y guías para usar IA sin empezar de cero.
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-dark-200">
          Esta es la biblioteca práctica de Decodifica: materiales cortos para convertir un vídeo o una idea en una prueba real. El objetivo no es coleccionar PDFs, sino ahorrar decisiones.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-dark-300">
          Si primero quieres elegir una app concreta, ve a la <a href="/herramientas/" class="font-semibold text-brand-300 hover:text-brand-200">biblioteca de herramientas IA</a>.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {categorias.map((categoria) => (
            <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1.5 text-sm text-dark-200">{categoria}</span>
          ))}
        </div>
      </div>
      <NewsletterForm
        title="Recibe nuevos recursos"
        description="Te enviamos los recursos nuevos y el filtro semanal de herramientas IA que merece la pena probar."
        buttonLabel="Recibir recursos"
      />
    </header>

    <section class="mt-12 grid gap-6 lg:grid-cols-3">
      {recursos.map((recurso) => (
        <article class="surface-panel flex h-full flex-col rounded-xl border border-dark-600 bg-dark-800 p-6">
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-lg bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{recurso.type}</span>
            <span class="text-xs text-dark-300">{recurso.status}</span>
          </div>
          <h2 class="mt-4 font-display text-xl font-bold text-white">{recurso.title}</h2>
          <p class="mt-2 grow text-sm leading-6 text-dark-200">{recurso.description}</p>
          <div class="mt-5 flex items-center justify-between gap-3">
            <span class="text-xs text-dark-300">
              {recurso.pages} pág.{recurso.version && recurso.updated ? ` · v${recurso.version} · ${recurso.updated}` : ''}
            </span>
            <a
              href={recurso.href}
              class="action-secondary pressable inline-flex w-fit items-center gap-2 rounded-lg border border-brand-700 bg-transparent px-3 py-1.5 text-sm font-semibold text-brand-300"
            >
              Abrir recurso
            </a>
          </div>
        </article>
      ))}
    </section>

    <section class="surface-panel mt-12 grid gap-5 rounded-xl border border-dark-600 bg-dark-800 p-6 lg:grid-cols-[.8fr_1.2fr] lg:p-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">Cómo aprovecharlos</p>
        <h2 class="mt-2 font-display text-3xl font-bold">De recurso a hábito</h2>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3">
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">1. Guarda un prompt.</strong> Empieza por una tarea concreta, no por una herramienta de moda.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">2. Pruébalo en tu contexto.</strong> Cambia datos, restricciones y formato de salida.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">3. Trae la duda.</strong> Usa la comunidad o responde a la newsletter cuando algo no encaje.</li>
      </ol>
    </section>

    <div id="newsletter" class="mt-14">
      <NewsletterForm
        title="Qué recurso te enviamos primero"
        description="Apúntate y usa esta biblioteca como punto de entrada a guías, prompts y flujos de Decodifica."
        buttonLabel="Apuntarme gratis"
      />
    </div>
  </div>
</BaseLayout>
