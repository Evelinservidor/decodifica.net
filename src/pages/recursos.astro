---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { env } from '~/lib/env';

const pdfUrl = `${env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/recursos/50-prompts-ia.pdf`;

const recursos = [
  {
    title: 'Mapa Decodifica de herramientas IA',
    description: 'Guia rapida para decidir que IA abrir primero segun la tarea: escribir, investigar, estudiar, programar, disenar, presentar o crear voz.',
    type: 'Mapa',
    pages: 1,
    href: '/recursos/mapa-herramientas-ia/',
    status: 'Disponible',
  },
  {
    title: '50 prompts para IA',
    description: 'Plantillas para escribir, investigar, resumir, planificar, aprender y trabajar mejor con ChatGPT, Claude o Gemini.',
    type: 'PDF',
    pages: 13,
    href: pdfUrl,
    status: 'Disponible',
  },
  {
    title: 'Workflows de IA para el dia a dia',
    description: 'Cinco flujos practicos para convertir tareas repetidas en procesos con IA: email, planificacion, analisis y aprendizaje.',
    type: 'PDF',
    pages: 8,
    href: '/lead-magnets/workflows-ia-dia-a-dia.pdf',
    status: 'Disponible',
  },
  {
    title: 'Mini curso: usar IA con mas contexto',
    description: 'Cinco lecciones breves para pasar de prompts sueltos a un sistema de trabajo mas estable.',
    type: 'Curso',
    pages: 5,
    href: '/newsletter',
    status: 'Proximo envio',
  },
];

const categorias = [
  'Prompts copiables',
  'Flujos de productividad',
  'Guias para elegir herramientas',
  'Material de apoyo de los videos',
];
---

<BaseLayout
  title="Recursos IA gratis"
  description="Biblioteca de recursos IA de Decodifica: prompts, workflows y guias practicas para aplicar inteligencia artificial en tareas reales."
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <header class="grid gap-8 lg:grid-cols-[1fr_420px] lg:items-center">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Recursos IA
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          Prompts, flujos y guias para usar IA sin empezar de cero.
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-dark-200">
          Esta es la biblioteca practica de Decodifica: materiales cortos para convertir un video o una idea en una prueba real. El objetivo no es coleccionar PDFs, sino ahorrar decisiones.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-dark-300">
          Si primero quieres elegir una app concreta, ve a la <a href="/herramientas" class="font-semibold text-brand-300 hover:text-brand-200">biblioteca de herramientas IA</a>.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {categorias.map((categoria) => (
            <span class="rounded-lg border border-dark-600 bg-dark-800 px-3 py-1.5 text-sm text-dark-200">{categoria}</span>
          ))}
        </div>
      </div>
      <NewsletterForm
        title="Recibe nuevos recursos"
        description="Te enviamos los recursos nuevos y el filtro semanal de herramientas IA que merece la pena probar."
        buttonLabel="Recibir recursos"
      />
    </header>

    <section class="mt-12 grid gap-6 lg:grid-cols-3">
      {recursos.map((recurso) => (
        <article class="flex h-full flex-col rounded-lg border border-dark-600 bg-dark-800 p-6 transition hover:border-brand-500/50">
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-lg bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{recurso.type}</span>
            <span class="text-xs text-dark-300">{recurso.status}</span>
          </div>
          <h2 class="mt-4 font-display text-xl font-bold text-white">{recurso.title}</h2>
          <p class="mt-2 grow text-sm leading-6 text-dark-200">{recurso.description}</p>
          <div class="mt-5 flex items-center justify-between gap-3">
            <span class="text-xs text-dark-300">{recurso.pages} pag.</span>
            <a
              href={recurso.href}
              class="inline-flex w-fit items-center gap-2 rounded-lg border border-brand-700 bg-transparent px-3 py-1.5 text-sm font-semibold text-brand-300 transition-all hover:bg-dark-700"
            >
              Abrir recurso
            </a>
          </div>
        </article>
      ))}
    </section>

    <section class="mt-12 grid gap-5 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:grid-cols-[.8fr_1.2fr] lg:p-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">Como aprovecharlos</p>
        <h2 class="mt-2 font-display text-3xl font-bold">De recurso a habito</h2>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3">
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">1. Guarda un prompt.</strong> Empieza por una tarea concreta, no por una herramienta de moda.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">2. Pruebalo en tu contexto.</strong> Cambia datos, restricciones y formato de salida.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">3. Trae la duda.</strong> Usa la comunidad o responde a la newsletter cuando algo no encaje.</li>
      </ol>
    </section>

    <div id="newsletter" class="mt-14">
      <NewsletterForm
        title="Que recurso te enviamos primero"
        description="Apuntate y usa esta biblioteca como punto de entrada a guias, prompts y flujos de Decodifica."
        buttonLabel="Apuntarme gratis"
      />
    </div>
  </div>
</BaseLayout>
