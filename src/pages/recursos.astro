---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { env } from '~/lib/env';

const pdfUrl = `${env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/recursos/50-prompts-ia.pdf`;

const recursos = [
  {
    title: '50 prompts para IA',
    description:
      'Plantillas para escribir, investigar, resumir, planificar y trabajar mejor con ChatGPT, Claude o Gemini.',
    type: 'PDF',
    pages: 13,
    icon: 'PDF',
    downloadUrl: pdfUrl,
  },
  {
    title: 'Workflows de IA para el día a día',
    description:
      'Cinco flujos prácticos para convertir tareas repetidas en procesos con IA.',
    type: 'PDF',
    pages: 8,
    icon: 'Workflow',
    downloadUrl: '/lead-magnets/workflows-ia-dia-a-dia.pdf',
  },
  {
    title: 'Mini curso: usar IA con más contexto',
    description:
      'Cinco lecciones breves para pasar de prompts sueltos a un sistema de trabajo más estable.',
    type: 'Curso',
    pages: 5,
    icon: 'Curso',
    downloadUrl: '/comunidad',
    comingSoon: true,
  },
];
---

<BaseLayout
  title="Recursos gratis de IA"
  description="PDFs, prompts y workflows gratis para aplicar IA en tareas reales sin perder tiempo."
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <header class="mx-auto max-w-3xl text-center">
      <p class="mb-4 inline-flex rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
        Biblioteca práctica
      </p>
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Recursos gratis para usar IA mejor</h1>
      <p class="mt-4 text-lg text-dark-200">
        Descarga prompts, workflows y guías que convierten los vídeos de Decodifica en acciones concretas.
      </p>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recursos.map((recurso) => (
        <article class="flex h-full flex-col rounded-2xl border border-dark-600 bg-gradient-to-br from-dark-700 to-dark-800 p-6 transition hover:border-brand-500/50">
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{recurso.icon}</span>
            <span class="text-xs text-dark-300">{recurso.pages} pág.</span>
          </div>
          <h2 class="mt-4 font-display text-xl font-bold text-white">
            {recurso.title}
          </h2>
          <p class="mt-2 grow text-sm text-dark-200">
            {recurso.description}
          </p>
          <div class="mt-5">
            {recurso.comingSoon ? (
              <span class="inline-flex items-center gap-2 rounded-lg border border-dark-500 bg-dark-600 px-3 py-1.5 text-sm font-semibold text-dark-300">
                Próximamente
              </span>
            ) : (
              <a
                href="#newsletter"
                class="inline-flex w-fit items-center gap-2 rounded-lg border border-brand-700 bg-transparent px-3 py-1.5 text-sm font-semibold text-brand-300 transition-all hover:bg-dark-700"
              >
                Recibir por email →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <div id="newsletter" class="mt-14">
      <NewsletterForm
        title="Recibe los recursos y próximos envíos"
        description="Apúntate y usa esta biblioteca como punto de entrada a guías, prompts y workflows de Decodifica."
        buttonLabel="Enviar recursos"
      />
    </div>
  </div>
</BaseLayout>
