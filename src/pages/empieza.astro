---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';

const tasks = [
  { id: 'investigar', title: 'Investigar con fuentes', description: 'Encontrar, contrastar y citar información antes de decidir.' },
  { id: 'resumir', title: 'Resumir documentos', description: 'Convertir PDFs, notas o vídeos en material revisable.' },
  { id: 'reuniones', title: 'Preparar reuniones', description: 'Pasar de una transcripción a decisiones y tareas.' },
  { id: 'emails', title: 'Redactar emails', description: 'Crear un borrador claro sin delegar el tono final.' },
  { id: 'presentaciones', title: 'Crear presentaciones', description: 'Transformar un briefing en una estructura que puedas revisar.' },
  { id: 'hojas', title: 'Analizar hojas de cálculo', description: 'Probar fórmulas, análisis y cambios con una copia de control.' },
];
---

<BaseLayout
  title="Empieza por una tarea de trabajo"
  description="Elige una tarea repetitiva y recibe una ruta de IA que puedas probar, revisar y reutilizar."
>
  <section class="border-b border-dark-600 bg-dark-900">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
      <p class="inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">Diagnóstico Decodifica · versión inicial</p>
      <h1 class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">¿Qué ruta de IA tiene sentido para esta tarea?</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-dark-200">Elige una tarea. Recibirás una ruta inicial, una prueba pequeña y el límite que debes revisar antes de convertirla en rutina.</p>
    </div>
  </section>

  <section id="selector" class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">1. Elige una tarea</p>
        <h2 class="mt-2 font-display text-3xl font-bold">No empieces por la herramienta.</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="group" aria-label="Tareas para diagnosticar">
        {tasks.map((task, index) => (
          <button id={task.id} type="button" data-task={task.id} aria-pressed={index === 0 ? 'true' : 'false'} class:list={[
            'task-selector rounded-xl border p-5 text-left transition focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-900',
            index === 0 ? 'border-brand-500 bg-brand-500/10' : 'border-dark-600 bg-dark-800 hover:border-brand-500/60',
          ]}>
            <span class="font-display text-xl font-bold text-white">{task.title}</span>
            <span class="mt-2 block text-sm leading-6 text-dark-200">{task.description}</span>
          </button>
        ))}
      </div>

      <div class="mt-10">
        <p class="text-sm font-semibold text-brand-300">2. Prueba esta ruta</p>

        <article data-result="investigar" class="task-result mt-4 rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-white">Investigar con fuentes</h2>
          <p class="mt-3 text-dark-200">Si ya tienes documentos, empieza con NotebookLM. Si todavía debes encontrar fuentes, compara primero con Perplexity.</p>
          <div class="mt-6 grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">Prueba</p><p class="mt-1 text-sm text-white">Sube tres fuentes y pide una conclusión con cita para cada punto.</p></div><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">No delegues</p><p class="mt-1 text-sm text-white">La verificación de la fuente original ni una decisión con impacto.</p></div></div>
          <a href="/herramientas/notebooklm-vs-perplexity/" class="mt-7 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Ver la comparativa <span aria-hidden="true">→</span></a>
        </article>

        <article data-result="resumir" class="task-result mt-4 hidden rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-white">Resumir documentos</h2><p class="mt-3 text-dark-200">Empieza con una fuente corta y un resultado que puedas comparar con el original.</p><div class="mt-6 grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">Prueba</p><p class="mt-1 text-sm text-white">Pide cinco conclusiones y comprueba cada una contra el documento.</p></div><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">No delegues</p><p class="mt-1 text-sm text-white">Datos, citas o matices que deban ser exactos.</p></div></div><a href="/blog/notebooklm-guia-2026/" class="mt-7 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Ver la guía de NotebookLM <span aria-hidden="true">→</span></a>
        </article>

        <article data-result="reuniones" class="task-result mt-4 hidden rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-white">Preparar reuniones</h2><p class="mt-3 text-dark-200">Usa la IA para proponer decisiones y tareas desde una transcripción; valida responsables, fechas y permisos antes de crear nada.</p><div class="mt-6 grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">Prueba</p><p class="mt-1 text-sm text-white">Procesa una reunión no sensible y compara la lista con tus notas.</p></div><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">No delegues</p><p class="mt-1 text-sm text-white">Asignar tareas o enviar datos sin revisión humana.</p></div></div><a href="/blog/ia-organiza-pendientes/" class="mt-7 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Ver opciones y permisos <span aria-hidden="true">→</span></a>
        </article>

        <article data-result="emails" class="task-result mt-4 hidden rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-white">Redactar emails</h2><p class="mt-3 text-dark-200">Empieza con un borrador, el objetivo y ejemplos de tono que puedas compartir sin exponer información sensible.</p><div class="mt-6 grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">Prueba</p><p class="mt-1 text-sm text-white">Compara un email real anonimizado con tu versión final.</p></div><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">No delegues</p><p class="mt-1 text-sm text-white">El tono, compromisos, cifras o decisiones finales.</p></div></div><a href="/blog/claude-emails-sonar-humanos/" class="mt-7 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Ver guía para emails <span aria-hidden="true">→</span></a>
        </article>

        <article data-result="presentaciones" class="task-result mt-4 hidden rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-white">Crear presentaciones</h2><p class="mt-3 text-dark-200">Convierte primero el briefing en una estructura. Después usa una herramienta visual y revisa cada dato y diapositiva.</p><div class="mt-6 grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">Prueba</p><p class="mt-1 text-sm text-white">Genera cinco diapositivas desde un briefing y revisa el export.</p></div><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">No delegues</p><p class="mt-1 text-sm text-white">La historia, la marca y los datos de la presentación.</p></div></div><a href="/herramientas/para-presentaciones/" class="mt-7 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Ver herramientas para presentaciones <span aria-hidden="true">→</span></a>
        </article>

        <article data-result="hojas" class="task-result mt-4 hidden rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-white">Analizar hojas de cálculo</h2><p class="mt-3 text-dark-200">Prueba una fórmula o un análisis en una copia de la hoja antes de tocar el archivo que usas cada semana.</p><div class="mt-6 grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">Prueba</p><p class="mt-1 text-sm text-white">Elige tres fórmulas repetitivas y valida el resultado con datos conocidos.</p></div><div><p class="text-xs font-semibold uppercase tracking-wide text-dark-300">No delegues</p><p class="mt-1 text-sm text-white">Validación financiera, permisos y cambios sobre la hoja original.</p></div></div><a href="/blog/ia-mejora-excel/" class="mt-7 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Ver guía de IA para Excel <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-dark-600 bg-dark-800/50 py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <NewsletterForm title="Guarda la siguiente ruta que merezca la pena" description="Cada semana: una tarea, varias opciones, una prueba pequeña y el límite que debes revisar." buttonLabel="Recibir el filtro semanal" />
    </div>
  </section>
</BaseLayout>

<script>
  const selectors = document.querySelectorAll<HTMLButtonElement>('[data-task]');
  const results = document.querySelectorAll<HTMLElement>('[data-result]');

  const selectTask = (id: string) => {
    selectors.forEach((selector) => {
      const selected = selector.dataset.task === id;
      selector.setAttribute('aria-pressed', String(selected));
      selector.classList.toggle('border-brand-500', selected);
      selector.classList.toggle('bg-brand-500/10', selected);
      selector.classList.toggle('border-dark-600', !selected);
      selector.classList.toggle('bg-dark-800', !selected);
    });
    results.forEach((result) => result.classList.toggle('hidden', result.dataset.result !== id));
  };

  selectors.forEach((selector) => selector.addEventListener('click', () => selectTask(selector.dataset.task || 'investigar')));
  const fromHash = window.location.hash.replace('#', '');
  if (fromHash && document.querySelector(`[data-task="${fromHash}"]`)) selectTask(fromHash);
</script>
