---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { tools } from '~/data/tools';
import { toolUseCases } from '~/data/tool-use-cases';
import { toolComparisons } from '~/data/tool-comparisons';

const latestVerifiedAt = tools
  .map((tool) => tool.verifiedAt)
  .filter((value): value is string => Boolean(value))
  .sort()
  .at(-1) ?? '2026-07-14';
const updatedAt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${latestVerifiedAt}T00:00:00Z`));
const useCases = [...new Set(tools.map((tool) => tool.useCase))].sort();
const prices = [...new Set(tools.map((tool) => tool.price))].sort();
const privacyLevels = ['Baja', 'Media', 'Alta'];
const difficulties = ['Baja', 'Media', 'Alta'];
const legacyUseCases = new Set(['para-estudiar', 'para-crear-contenido', 'para-programar', 'para-presentaciones']);
const useCaseHref = (slug: string) => legacyUseCases.has(slug) ? `/herramientas/${slug}/` : `/herramientas/casos/${slug}/`;
---

<BaseLayout
  title="Herramientas de IA por tarea"
  description="Biblioteca filtrable de herramientas IA recomendadas por Decodifica: caso de uso, precio, privacidad, dificultad y cuando usar cada una."
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <header class="grid gap-8 lg:grid-cols-[1fr_380px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Biblioteca de herramientas IA
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          Elige una herramienta por tarea, no por ruido.
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-dark-200">
          Una biblioteca viva para comparar herramientas de IA por caso de uso, precio, privacidad, dificultad y momento adecuado. No es un ranking: es un mapa para decidir qué probar primero.
        </p>
        <div class="mt-6 grid gap-3 text-sm sm:grid-cols-3">
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <div class="text-2xl font-bold text-white">{tools.length}</div>
            <div class="mt-1 text-dark-300">fichas prácticas</div>
          </div>
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <div class="text-2xl font-bold text-white">{toolUseCases.length}</div>
            <div class="mt-1 text-dark-300">guías por tarea</div>
          </div>
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <div class="text-2xl font-bold text-white">0</div>
            <div class="mt-1 text-dark-300">ranking patrocinado</div>
          </div>
        </div>
        <p class="mt-4 text-xs text-dark-400">Actualizado: {updatedAt}</p>
      </div>

      <NewsletterForm
        title="Recibe nuevas fichas"
        description="Te avisamos cuando añadamos herramientas útiles, comparativas y recursos para probarlas mejor."
        buttonLabel="Seguir la biblioteca"
      />
    </header>

    <section class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4" aria-label="Utilidades gratuitas">
      {[
        { title: 'Comparar herramientas', description: 'Pon dos o tres opciones frente a frente con la misma matriz.', href: '/herramientas/comparador/', event: 'utility_compare_opened' },
        { title: 'Construir un prompt', description: 'Convierte una tarea en un prompt estructurado y revisable.', href: '/herramientas/generador-prompts/', event: 'utility_prompt_opened' },
        { title: 'Revisar datos', description: 'Comprueba riesgos antes de subir información a una IA.', href: '/herramientas/preflight-datos/', event: 'utility_preflight_opened' },
        { title: 'Evaluar un resultado', description: 'Decide si el flujo merece conservarse, repetirse o descartarse.', href: '/herramientas/evaluador/', event: 'utility_evaluator_opened' },
      ].map((utility) => (
        <a href={utility.href} data-track={utility.event} data-track-label={utility.title} data-track-component="tools_utility_hub" class="rounded-lg border border-brand-500/30 bg-dark-800 p-5 transition hover:border-brand-400">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-300">Utilidad gratuita</p><h2 class="mt-2 font-display text-xl font-bold">{utility.title}</h2><p class="mt-2 text-sm leading-6 text-dark-300">{utility.description}</p>
        </a>
      ))}
    </section>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-4 sm:p-5" aria-label="Filtros de herramientas IA">
      <div class="grid gap-3 lg:grid-cols-[1.4fr_repeat(4,1fr)_auto] lg:items-end">
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Buscar</span>
          <input
            id="tool-search"
            type="search"
            placeholder="ChatGPT, voz, documentos..."
            class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500"
          />
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Caso</span>
          <select id="tool-use-case" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todos</option>
            {useCases.map((useCase) => <option value={useCase}>{useCase}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Precio</span>
          <select id="tool-price" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todos</option>
            {prices.map((price) => <option value={price}>{price}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Privacidad</span>
          <select id="tool-privacy" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todas</option>
            {privacyLevels.map((privacy) => <option value={privacy}>{privacy}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Dificultad</span>
          <select id="tool-difficulty" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todas</option>
            {difficulties.map((difficulty) => <option value={difficulty}>{difficulty}</option>)}
          </select>
        </label>
        <button id="tool-reset" type="button" class="rounded-lg border border-dark-600 bg-dark-900 px-4 py-2 text-sm font-semibold text-white transition hover:border-brand-500/60">
          Limpiar
        </button>
      </div>
      <p class="mt-4 text-sm text-dark-300">
        <span id="tool-count">{tools.length}</span> herramientas visibles. Precio y condiciones pueden cambiar; revisa siempre la página oficial antes de pagar o subir datos sensibles.
      </p>
    </section>

    <section class="mt-8 rounded-lg border border-dark-600 bg-dark-800 p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-brand-300">Por caso de uso</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Empieza por la tarea, no por la marca</h2>
        </div>
        <a href="/recursos/mapa-herramientas-ia/" class="text-sm font-semibold text-brand-300 hover:text-brand-200">Ver mapa completo</a>
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {toolUseCases.map((useCase) => (
          <a href={useCaseHref(useCase.slug)} data-track="tools_hub_use_case_click" data-track-label={useCase.slug} data-track-component="tools_hub" class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
            <h3 class="font-display text-lg font-bold text-white">{useCase.title}</h3>
            <p class="mt-2 text-sm leading-6 text-dark-300">{useCase.intro}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-8 grid gap-5 lg:grid-cols-3" id="tool-grid">
      {tools.map((tool) => {
        const detailHref = `/herramientas/${tool.slug}/`;
        const primaryHref = tool.hasDetailPage ? detailHref : tool.officialUrl;
        const primaryLabel = tool.hasDetailPage ? 'Ver ficha práctica' : 'Ver página oficial';
        return (
          <article
            class="tool-card flex h-full flex-col rounded-lg border border-dark-600 bg-dark-800 p-5 transition hover:border-brand-500/50"
            data-name={tool.name.toLowerCase()}
            data-summary={tool.summary.toLowerCase()}
            data-tags={tool.tags.join(' ').toLowerCase()}
            data-use-case={tool.useCase}
            data-price={tool.price}
            data-privacy={tool.privacy}
            data-difficulty={tool.difficulty}
          >
            <div class="flex flex-wrap gap-2">
              <span class="rounded-lg bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{tool.useCase}</span>
              <span class="rounded-lg border border-dark-600 px-3 py-1 text-xs text-dark-200">{tool.price}</span>
              <span class="rounded-lg border border-dark-600 px-3 py-1 text-xs text-dark-200">Privacidad {tool.privacy}</span>
              <span class="rounded-lg border border-dark-600 px-3 py-1 text-xs text-dark-200">{tool.difficulty}</span>
            </div>
            <h2 class="mt-4 font-display text-2xl font-bold text-white">{tool.name}</h2>
            <p class="mt-3 text-sm leading-6 text-dark-200">{tool.summary}</p>

            <div class="mt-5 grid gap-3 text-sm leading-6">
              <div>
                <div class="font-semibold text-white">Cuando usarla</div>
                <p class="mt-1 text-dark-200">{tool.bestFor}</p>
              </div>
              <div>
                <div class="font-semibold text-white">Evítala si</div>
                <p class="mt-1 text-dark-200">{tool.avoidIf}</p>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap gap-2">
              {tool.tags.map((tag) => (
                <span class="rounded-lg bg-dark-900 px-2.5 py-1 text-xs text-dark-300">{tag}</span>
              ))}
            </div>

            <div class="mt-6 flex grow flex-col justify-end gap-3">
              <a href={primaryHref} target={tool.hasDetailPage ? undefined : '_blank'} rel={tool.hasDetailPage ? undefined : 'noopener'} data-track={tool.hasDetailPage ? 'tool_card_click' : 'official_tool_click'} data-track-label={tool.slug} data-track-component="tools_hub" class="inline-flex w-fit rounded-lg bg-brand-500 px-3 py-2 text-sm font-semibold text-white transition hover:bg-brand-600">
                {primaryLabel}
              </a>
              <a href={tool.relatedLinks[0]?.href ?? '/blog/como-elegir-herramienta-ia/'} data-track="tool_to_comparison_click" data-track-label={`${tool.slug}:primary_related`} data-track-component="tools_hub" class="text-sm font-semibold text-brand-300 hover:text-brand-200">
                {tool.relatedLinks[0]?.label ?? 'Cómo elegir una herramienta IA'}
              </a>
            </div>
          </article>
        );
      })}
    </section>

    <p id="tool-empty" class="mt-8 hidden rounded-lg border border-dark-600 bg-dark-800 p-6 text-sm text-dark-200">
      No hay herramientas con esos filtros. Prueba a quitar un criterio o busca por tarea.
    </p>

    <section class="mt-12 rounded-lg border border-brand-500/30 bg-dark-800 p-6 lg:p-8">
      <div class="grid gap-5 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold text-brand-300">Recurso recomendado</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Mapa Decodifica: qué IA usar según tu tarea</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">
            Antes de probar herramientas al azar, usa el mapa para elegir la primera app según tarea, riesgo y resultado esperado.
          </p>
          <a href="/recursos/mapa-herramientas-ia/" class="mt-5 inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">
            Abrir el mapa
          </a>
        </div>
        <ol class="grid gap-4 sm:grid-cols-3">
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">1. Tarea.</strong> Define si vas a escribir, investigar, estudiar, programar, disenar, presentar o crear voz.</li>
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">2. Riesgo.</strong> Revisa datos sensibles, pago, fuentes y derechos antes de subir nada.</li>
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">3. Primera prueba.</strong> Abre una sola herramienta y valida el resultado con una tarea real.</li>
        </ol>
      </div>
    </section>

    <section class="mt-12 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:p-8">
      <div class="grid gap-5 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold text-brand-300">Comparativas</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Cuando dos herramientas parecen iguales</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">
            Algunas decisiones no se resuelven con una ficha aislada. Estas guías comparan herramientas que compiten por la misma tarea.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <a href="/herramientas/chatgpt-vs-claude/" class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
            <h3 class="font-display text-xl font-bold text-white">ChatGPT vs Claude</h3>
            <p class="mt-2 text-sm leading-6 text-dark-300">Qué abrir primero para escritura, documentos, código, privacidad y uso general.</p>
          </a>
          <a href="/herramientas/notebooklm-vs-perplexity/" class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
            <h3 class="font-display text-xl font-bold text-white">NotebookLM vs Perplexity</h3>
            <p class="mt-2 text-sm leading-6 text-dark-300">Cuando usar fuentes propias y cuando empezar por busqueda web con IA.</p>
          </a>
          <a href="/herramientas/gamma-vs-canva-ai/" class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
            <h3 class="font-display text-xl font-bold text-white">Gamma vs Canva AI</h3>
            <p class="mt-2 text-sm leading-6 text-dark-300">Qué usar para presentaciones, piezas visuales, marca y formatos de redes.</p>
          </a>
          <a href="/herramientas/alternativas-elevenlabs/" class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
            <h3 class="font-display text-xl font-bold text-white">Alternativas a ElevenLabs</h3>
            <p class="mt-2 text-sm leading-6 text-dark-300">Qué mirar para locución, doblaje, agentes de voz, API y clonación segura.</p>
          </a>
          {toolComparisons.map((comparison) => (
            <a href={`/herramientas/comparativas/${comparison.slug}/`} class="rounded-lg border border-dark-600 bg-dark-900 p-4 transition hover:border-brand-500/60">
              <h3 class="font-display text-xl font-bold text-white">{comparison.title}</h3>
              <p class="mt-2 text-sm leading-6 text-dark-300">{comparison.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-12 grid gap-5 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:grid-cols-[.75fr_1.25fr] lg:p-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">Criterio Decodifica</p>
        <h2 class="mt-2 font-display text-3xl font-bold">Cómo entra una herramienta aquí</h2>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3">
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">1. Caso claro.</strong> Tiene que resolver una tarea real, no solo sonar novedosa.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">2. Riesgo visible.</strong> Precio, privacidad y dificultad deben entenderse antes de probar.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">3. Siguiente paso.</strong> Debe conectar con una guia, recurso, video o prueba concreta.</li>
      </ol>
    </section>

    <div class="mt-12" id="newsletter">
      <NewsletterForm
        title="No pruebes herramientas al azar"
        description="Apúntate y recibe el filtro Decodifica: qué herramienta mirar, para qué sirve y qué comprobar antes de pagar."
        buttonLabel="Recibir el filtro"
      />
    </div>
  </div>

  <script>
    const search = document.querySelector('#tool-search');
    const useCase = document.querySelector('#tool-use-case');
    const price = document.querySelector('#tool-price');
    const privacy = document.querySelector('#tool-privacy');
    const difficulty = document.querySelector('#tool-difficulty');
    const reset = document.querySelector('#tool-reset');
    const cards = Array.from(document.querySelectorAll('.tool-card'));
    const count = document.querySelector('#tool-count');
    const empty = document.querySelector('#tool-empty');
    let filterTimer;

    const normalize = (value) => (value || '').toString().trim().toLowerCase();
    const track = (event, props = {}) => {
      window.DecodificaTrack?.emit?.(event, {
        component: 'tools_filters',
        ...props,
      });
    };

    function applyFilters() {
      const query = normalize(search?.value);
      const selectedUseCase = useCase?.value || '';
      const selectedPrice = price?.value || '';
      const selectedPrivacy = privacy?.value || '';
      const selectedDifficulty = difficulty?.value || '';
      let visible = 0;

      cards.forEach((card) => {
        const text = [
          card.dataset.name,
          card.dataset.summary,
          card.dataset.tags,
        ].join(' ');
        const matchesQuery = !query || normalize(text).includes(query);
        const matchesUseCase = !selectedUseCase || card.dataset.useCase === selectedUseCase;
        const matchesPrice = !selectedPrice || card.dataset.price === selectedPrice;
        const matchesPrivacy = !selectedPrivacy || card.dataset.privacy === selectedPrivacy;
        const matchesDifficulty = !selectedDifficulty || card.dataset.difficulty === selectedDifficulty;
        const matches = matchesQuery && matchesUseCase && matchesPrice && matchesPrivacy && matchesDifficulty;
        card.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });

      if (count) count.textContent = String(visible);
      empty?.classList.toggle('hidden', visible !== 0);

      window.clearTimeout(filterTimer);
      filterTimer = window.setTimeout(() => {
        track('tools_filter_change', {
          query,
          useCase: selectedUseCase,
          price: selectedPrice,
          privacy: selectedPrivacy,
          difficulty: selectedDifficulty,
          visible,
        });
      }, 700);
    }

    [search, useCase, price, privacy, difficulty].forEach((control) => {
      control?.addEventListener('input', applyFilters);
      control?.addEventListener('change', applyFilters);
    });

    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      if (useCase) useCase.value = '';
      if (price) price.value = '';
      if (privacy) privacy.value = '';
      if (difficulty) difficulty.value = '';
      track('tools_filter_reset');
      applyFilters();
    });
  </script>
</BaseLayout>
