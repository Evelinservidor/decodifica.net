---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';

const updatedAt = '7 julio 2026';

const tools = [
  {
    name: 'ChatGPT',
    summary: 'Asistente general para escribir, idear, resumir, programar y convertir tareas abiertas en borradores accionables.',
    useCase: 'Asistente general',
    price: 'Freemium',
    privacy: 'Media',
    difficulty: 'Baja',
    bestFor: 'Cuando necesitas pensar, escribir o desbloquear una tarea sin montar un sistema complejo.',
    avoidIf: 'Vas a subir datos sensibles sin revisar ajustes, permisos o plan de empresa.',
    tags: ['escritura', 'productividad', 'codigo', 'analisis'],
    officialUrl: 'https://chatgpt.com/pricing/',
    relatedHref: '/blog/como-elegir-herramienta-ia/',
    relatedLabel: 'Como elegir una herramienta IA',
  },
  {
    name: 'Claude',
    summary: 'Modelo conversacional fuerte para documentos largos, escritura cuidada, razonamiento y trabajo con instrucciones reutilizables.',
    useCase: 'Escritura y documentos',
    price: 'Freemium',
    privacy: 'Media',
    difficulty: 'Baja',
    bestFor: 'Cuando necesitas transformar textos largos, preparar documentos o crear sistemas de prompts mas estables.',
    avoidIf: 'Solo quieres respuestas cortas y no vas a aprovechar contexto, archivos o instrucciones.',
    tags: ['documentos', 'escritura', 'prompts', 'contexto'],
    officialUrl: 'https://claude.com/pricing',
    relatedHref: '/blog/claude-skills-desde-cero/',
    relatedLabel: 'Claude Skills desde cero',
  },
  {
    name: 'NotebookLM',
    summary: 'Herramienta de Google para trabajar con fuentes propias: PDFs, webs, videos, notas y materiales de estudio.',
    useCase: 'Investigacion',
    price: 'Freemium',
    privacy: 'Media',
    difficulty: 'Baja',
    bestFor: 'Cuando quieres preguntar a tus propias fuentes y mantener la respuesta anclada al material que has subido.',
    avoidIf: 'Necesitas automatizar acciones fuera del cuaderno o trabajar con informacion muy confidencial sin revisar condiciones.',
    tags: ['fuentes', 'investigacion', 'estudio', 'resumen'],
    officialUrl: 'https://notebooklm.google/',
    relatedHref: '/blog/notebooklm-guia-2026/',
    relatedLabel: 'Guia NotebookLM',
  },
  {
    name: 'Perplexity',
    summary: 'Buscador con IA para explorar temas, encontrar fuentes y arrancar una investigacion sin partir de una pagina en blanco.',
    useCase: 'Investigacion',
    price: 'Freemium',
    privacy: 'Baja',
    difficulty: 'Baja',
    bestFor: 'Cuando necesitas contexto rapido, fuentes y una primera comparacion antes de decidir que leer a fondo.',
    avoidIf: 'Vas a aceptar la respuesta sin abrir fuentes o necesitas una verificacion legal, medica o financiera.',
    tags: ['busqueda', 'fuentes', 'comparacion', 'contexto'],
    officialUrl: 'https://www.perplexity.ai/pro',
    relatedHref: '/blog/como-elegir-herramienta-ia/',
    relatedLabel: 'Metodo de evaluacion',
  },
  {
    name: 'Gamma',
    summary: 'Creador de presentaciones, documentos y paginas visuales a partir de una idea o estructura inicial.',
    useCase: 'Presentaciones',
    price: 'Freemium',
    privacy: 'Media',
    difficulty: 'Baja',
    bestFor: 'Cuando necesitas un primer borrador visual rapido para ordenar una presentacion o propuesta.',
    avoidIf: 'La pieza final exige identidad visual muy estricta o datos corporativos que no puedes subir a terceros.',
    tags: ['presentaciones', 'diseño', 'propuestas', 'borradores'],
    officialUrl: 'https://gamma.app/pricing',
    relatedHref: '/blog/ia-crea-presentaciones-completas/',
    relatedLabel: 'IA para presentaciones',
  },
  {
    name: 'Canva AI',
    summary: 'Suite visual con funciones de IA para crear piezas graficas, editar diseños y producir materiales de comunicacion.',
    useCase: 'Diseño',
    price: 'Freemium',
    privacy: 'Media',
    difficulty: 'Baja',
    bestFor: 'Cuando necesitas publicar una pieza visual decente sin abrir una herramienta profesional de diseño.',
    avoidIf: 'Necesitas control fino de marca, trazabilidad completa o archivos de produccion complejos.',
    tags: ['diseño', 'redes', 'presentaciones', 'marca'],
    officialUrl: 'https://www.canva.com/en/pricing/',
    relatedHref: '/recursos/',
    relatedLabel: 'Recursos IA',
  },
  {
    name: 'ElevenLabs',
    summary: 'Herramienta de voz IA para generar locuciones, doblaje y audio sintetico con control de voces e idiomas.',
    useCase: 'Audio y voz',
    price: 'Freemium',
    privacy: 'Alta',
    difficulty: 'Media',
    bestFor: 'Cuando necesitas probar voces, doblajes o narraciones con calidad suficiente para piezas publicas.',
    avoidIf: 'No tienes claro el permiso de una voz, el uso comercial o la politica de datos del proyecto.',
    tags: ['voz', 'audio', 'doblaje', 'video'],
    officialUrl: 'https://elevenlabs.io/pricing',
    relatedHref: '/blog/crear-agente-voz-ia-sin-programar/',
    relatedLabel: 'Agentes de voz IA',
  },
  {
    name: 'Qwen Code',
    summary: 'Agente de codigo abierto para trabajar desde terminal con bases de codigo y tareas tecnicas.',
    useCase: 'Codigo',
    price: 'Open source',
    privacy: 'Alta',
    difficulty: 'Alta',
    bestFor: 'Cuando sabes trabajar en terminal y quieres automatizar tareas tecnicas dentro de un proyecto real.',
    avoidIf: 'Buscas una app visual sencilla o no puedes revisar lo que un agente cambia en tu codigo.',
    tags: ['codigo', 'terminal', 'agentes', 'open source'],
    officialUrl: 'https://qwen.ai/qwencode',
    relatedHref: '/blog/qwen-code-agent-terminal/',
    relatedLabel: 'Qwen Code en terminal',
  },
  {
    name: 'DeepSeek',
    summary: 'Asistente y modelos de IA con foco en coste bajo, razonamiento y opciones para uso por app o API.',
    useCase: 'Asistente general',
    price: 'Freemium',
    privacy: 'Media',
    difficulty: 'Media',
    bestFor: 'Cuando quieres comparar respuestas, probar modelos alternativos o explorar opciones de bajo coste.',
    avoidIf: 'La prioridad es cumplimiento corporativo estricto o no puedes revisar donde procesas los datos.',
    tags: ['modelos', 'asistente', 'api', 'coste'],
    officialUrl: 'https://www.deepseek.com/en/',
    relatedHref: '/blog/deepseek-app-oficial-espanol/',
    relatedLabel: 'DeepSeek en español',
  },
];

const useCases = [...new Set(tools.map((tool) => tool.useCase))].sort();
const prices = [...new Set(tools.map((tool) => tool.price))].sort();
const privacyLevels = ['Baja', 'Media', 'Alta'];
const difficulties = ['Baja', 'Media', 'Alta'];
---

<BaseLayout
  title="Herramientas IA"
  description="Biblioteca filtrable de herramientas IA recomendadas por Decodifica: caso de uso, precio, privacidad, dificultad y cuando usar cada una."
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <header class="grid gap-8 lg:grid-cols-[1fr_380px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          Biblioteca de herramientas IA
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">
          Elige una herramienta por tarea, no por ruido.
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-dark-200">
          Una biblioteca viva para comparar herramientas de IA por caso de uso, precio, privacidad, dificultad y momento adecuado. No es un ranking: es un mapa para decidir que probar primero.
        </p>
        <div class="mt-6 grid gap-3 text-sm sm:grid-cols-3">
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <div class="text-2xl font-bold text-white">{tools.length}</div>
            <div class="mt-1 text-dark-300">fichas iniciales</div>
          </div>
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <div class="text-2xl font-bold text-white">{useCases.length}</div>
            <div class="mt-1 text-dark-300">casos de uso</div>
          </div>
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <div class="text-2xl font-bold text-white">0</div>
            <div class="mt-1 text-dark-300">ranking patrocinado</div>
          </div>
        </div>
      </div>

      <NewsletterForm
        title="Recibe nuevas fichas"
        description="Te avisamos cuando añadamos herramientas utiles, comparativas y recursos para probarlas mejor."
        buttonLabel="Seguir la biblioteca"
      />
    </header>

    <section class="mt-10 rounded-lg border border-dark-600 bg-dark-800 p-4 sm:p-5" aria-label="Filtros de herramientas IA">
      <div class="grid gap-3 lg:grid-cols-[1.4fr_repeat(4,1fr)_auto] lg:items-end">
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Buscar</span>
          <input
            id="tool-search"
            type="search"
            placeholder="ChatGPT, voz, documentos..."
            class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500"
          />
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Caso</span>
          <select id="tool-use-case" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todos</option>
            {useCases.map((useCase) => <option value={useCase}>{useCase}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Precio</span>
          <select id="tool-price" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todos</option>
            {prices.map((price) => <option value={price}>{price}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Privacidad</span>
          <select id="tool-privacy" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todas</option>
            {privacyLevels.map((privacy) => <option value={privacy}>{privacy}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase text-dark-300">Dificultad</span>
          <select id="tool-difficulty" class="mt-1 w-full rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm text-white outline-none transition focus:border-brand-500">
            <option value="">Todas</option>
            {difficulties.map((difficulty) => <option value={difficulty}>{difficulty}</option>)}
          </select>
        </label>
        <button id="tool-reset" type="button" class="rounded-lg border border-dark-600 bg-dark-900 px-4 py-2 text-sm font-semibold text-white transition hover:border-brand-500/60">
          Limpiar
        </button>
      </div>
      <p class="mt-4 text-sm text-dark-300">
        <span id="tool-count">{tools.length}</span> herramientas visibles. Precio y condiciones pueden cambiar; revisa siempre la pagina oficial antes de pagar o subir datos sensibles.
      </p>
    </section>

    <section class="mt-8 grid gap-5 lg:grid-cols-3" id="tool-grid">
      {tools.map((tool) => (
        <article
          class="tool-card flex h-full flex-col rounded-lg border border-dark-600 bg-dark-800 p-5 transition hover:border-brand-500/50"
          data-name={tool.name.toLowerCase()}
          data-summary={tool.summary.toLowerCase()}
          data-tags={tool.tags.join(' ').toLowerCase()}
          data-use-case={tool.useCase}
          data-price={tool.price}
          data-privacy={tool.privacy}
          data-difficulty={tool.difficulty}
        >
          <div class="flex flex-wrap gap-2">
            <span class="rounded-lg bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{tool.useCase}</span>
            <span class="rounded-lg border border-dark-600 px-3 py-1 text-xs text-dark-200">{tool.price}</span>
            <span class="rounded-lg border border-dark-600 px-3 py-1 text-xs text-dark-200">Privacidad {tool.privacy}</span>
            <span class="rounded-lg border border-dark-600 px-3 py-1 text-xs text-dark-200">{tool.difficulty}</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-bold text-white">{tool.name}</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">{tool.summary}</p>

          <div class="mt-5 grid gap-3 text-sm leading-6">
            <div>
              <div class="font-semibold text-white">Cuando usarla</div>
              <p class="mt-1 text-dark-200">{tool.bestFor}</p>
            </div>
            <div>
              <div class="font-semibold text-white">Evitala si</div>
              <p class="mt-1 text-dark-200">{tool.avoidIf}</p>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap gap-2">
            {tool.tags.map((tag) => (
              <span class="rounded-lg bg-dark-900 px-2.5 py-1 text-xs text-dark-300">{tag}</span>
            ))}
          </div>

          <div class="mt-6 flex grow flex-col justify-end gap-3">
            <a href={tool.relatedHref} class="text-sm font-semibold text-brand-300 hover:text-brand-200">
              {tool.relatedLabel}
            </a>
            <a href={tool.officialUrl} target="_blank" rel="noopener" class="inline-flex w-fit rounded-lg border border-dark-600 bg-dark-900 px-3 py-2 text-sm font-semibold text-white transition hover:border-brand-500/60">
              Ver pagina oficial
            </a>
          </div>
        </article>
      ))}
    </section>

    <p id="tool-empty" class="mt-8 hidden rounded-lg border border-dark-600 bg-dark-800 p-6 text-sm text-dark-200">
      No hay herramientas con esos filtros. Prueba a quitar un criterio o busca por tarea.
    </p>

    <section class="mt-12 grid gap-5 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:grid-cols-[.75fr_1.25fr] lg:p-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">Criterio Decodifica</p>
        <h2 class="mt-2 font-display text-3xl font-bold">Como entra una herramienta aqui</h2>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3">
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">1. Caso claro.</strong> Tiene que resolver una tarea real, no solo sonar novedosa.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">2. Riesgo visible.</strong> Precio, privacidad y dificultad deben entenderse antes de probar.</li>
        <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">3. Siguiente paso.</strong> Debe conectar con una guia, recurso, video o prueba concreta.</li>
      </ol>
    </section>

    <div class="mt-12" id="newsletter">
      <NewsletterForm
        title="No pruebes herramientas al azar"
        description="Apuntate y recibe el filtro Decodifica: que herramienta mirar, para que sirve y que comprobar antes de pagar."
        buttonLabel="Recibir el filtro"
      />
    </div>
  </div>

  <script>
    const search = document.querySelector('#tool-search');
    const useCase = document.querySelector('#tool-use-case');
    const price = document.querySelector('#tool-price');
    const privacy = document.querySelector('#tool-privacy');
    const difficulty = document.querySelector('#tool-difficulty');
    const reset = document.querySelector('#tool-reset');
    const cards = Array.from(document.querySelectorAll('.tool-card'));
    const count = document.querySelector('#tool-count');
    const empty = document.querySelector('#tool-empty');

    const normalize = (value) => (value || '').toString().trim().toLowerCase();

    function applyFilters() {
      const query = normalize(search?.value);
      const selectedUseCase = useCase?.value || '';
      const selectedPrice = price?.value || '';
      const selectedPrivacy = privacy?.value || '';
      const selectedDifficulty = difficulty?.value || '';
      let visible = 0;

      cards.forEach((card) => {
        const text = [
          card.dataset.name,
          card.dataset.summary,
          card.dataset.tags,
        ].join(' ');
        const matchesQuery = !query || normalize(text).includes(query);
        const matchesUseCase = !selectedUseCase || card.dataset.useCase === selectedUseCase;
        const matchesPrice = !selectedPrice || card.dataset.price === selectedPrice;
        const matchesPrivacy = !selectedPrivacy || card.dataset.privacy === selectedPrivacy;
        const matchesDifficulty = !selectedDifficulty || card.dataset.difficulty === selectedDifficulty;
        const matches = matchesQuery && matchesUseCase && matchesPrice && matchesPrivacy && matchesDifficulty;
        card.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });

      if (count) count.textContent = String(visible);
      empty?.classList.toggle('hidden', visible !== 0);
    }

    [search, useCase, price, privacy, difficulty].forEach((control) => {
      control?.addEventListener('input', applyFilters);
      control?.addEventListener('change', applyFilters);
    });

    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      if (useCase) useCase.value = '';
      if (price) price.value = '';
      if (privacy) privacy.value = '';
      if (difficulty) difficulty.value = '';
      applyFilters();
    });
  </script>
</BaseLayout>
