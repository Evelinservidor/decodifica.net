---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { siteConfig } from '~/lib/site-config';
---

<BaseLayout
  title="IA en español, sin fluff"
  description="Cada semana curamos las mejores herramientas de IA y te enseñamos a usarlas de verdad. Todo gratis en la web."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-brand-950 via-dark-900 to-dark-900"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-500/10 via-transparent to-transparent"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-700/50 bg-brand-950/50 px-3 py-1 text-xs font-medium text-brand-300">
          <span class="h-1.5 w-1.5 animate-pulse-slow rounded-full bg-accent-green"></span>
          Nuevo cada semana
        </div>

        <h1 class="font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          {siteConfig.tagline}
        </h1>

        <p class="mt-6 text-lg text-dark-200 sm:text-xl">
          {siteConfig.description}
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href={siteConfig.social.youtube} variant="primary" size="lg" external>
            ▶ Ver canal de YouTube
          </Button>
          <Button href="/blog" variant="secondary" size="lg">
            Leer el blog
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilares -->
  <section class="border-y border-dark-600 bg-dark-800/50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Dos pilares. Cero ruido.
        </h2>
        <p class="mt-4 text-dark-200">
          Nos centramos en lo que funciona. Sin clickbait, sin AI slop.
        </p>
      </div>

      <div class="mt-12 grid auto-rows-fr gap-6 sm:grid-cols-2">
        {siteConfig.pillars.map((pilar) => (
          <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-dark-600 bg-gradient-to-br from-dark-700 to-dark-800 p-8 transition-all hover:border-brand-500/50">
            <h3 class="font-display text-2xl font-bold text-white">
              {pilar.title}
            </h3>
            <p class="mt-3 flex-1 text-dark-200">
              {pilar.description}
            </p>
            <div class="mt-6">
              <Button href={`/blog?pilar=${pilar.id}`} variant="ghost" size="sm">
                Explorar →
              </Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>
