---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import TarjetaArticulo from '~/components/TarjetaArticulo.astro';
import { blogPostIndex } from '~/lib/blog-post-index';
import { masLeidos } from '~/lib/mas-leidos';
import { nombreTema, temas } from '~/lib/temas';
import { tools } from '~/data/tools';
import { practicalWorkflows } from '~/data/workflows';

const [destacado, ...resto] = blogPostIndex;
const ultimos = resto.slice(0, 4);
const masGuias = resto.slice(4, 8);
const top = masLeidos(5);
const cuenta = (clave: string) => blogPostIndex.filter((post) => post.tema === clave).length;
---

<BaseLayout
  title="IA práctica para trabajo real"
  description="Convierte una tarea repetitiva en un workflow de IA que puedas revisar y reutilizar cada semana."
>
  <nav class="border-b border-dark-600" aria-label="Temas">
    <div class="contenedor"><div class="chips py-2.5">
      <a class="chip activo" href="/blog/">Todas</a>
      {Object.entries(temas).map(([clave, tema]) => (
        <a class="chip" href={`/blog/?tema=${clave}`}>{tema.nombre}</a>
      ))}
    </div></div>
  </nav>

  <div class="contenedor">
    <header class="pt-6">
      <h1 class="font-display text-[26px] leading-tight text-white sm:text-3xl">Guías de IA práctica en español</h1>
      <p class="mt-1.5 text-[15px] leading-6 text-dark-200">
        Qué es cada herramienta, cuánto cuesta y cómo se usa. Con fuentes oficiales y sin relleno.
      </p>
    </header>

    <section class="py-6" aria-labelledby="lo-ultimo">
      <div class="seccion-cabecera">
        <h2 id="lo-ultimo" class="font-display text-white">Lo último</h2>
        <a href="/blog/">Todas las guías →</a>
      </div>
      <div class="grid gap-x-9 lg:grid-cols-[1.55fr_1fr]">
        {destacado && <TarjetaArticulo post={destacado} variante="destacado" prioridad track="home_latest_click" />}
        <div class="mt-4 lg:mt-0 [&>a:first-child]:lg:border-t-0 [&>a:first-child]:lg:pt-0">
          {ultimos.map((post) => <TarjetaArticulo post={post} variante="fila" track="home_latest_click" />)}
        </div>
      </div>
    </section>

    <div class="grid gap-x-10 lg:grid-cols-[2fr_1fr]">
      <section class="py-6" aria-labelledby="mas-guias">
        <div class="seccion-cabecera"><h2 id="mas-guias" class="font-display text-white">Más guías</h2></div>
        <div class="grid gap-6 sm:grid-cols-2">
          {masGuias.map((post) => <TarjetaArticulo post={post} track="home_more_click" />)}
        </div>
      </section>

      <section class="py-6" aria-labelledby="mas-leido">
        <div class="seccion-cabecera"><h2 id="mas-leido" class="font-display text-white">Lo más leído</h2></div>
        <ol class="top5">
          {top.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`} data-track="home_popular_click" data-track-label={post.slug}>
                <h3 class="font-display text-white">{post.title}</h3>
                <p class="tarjeta-meta mt-1">{nombreTema(post.tema)}</p>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <section class="py-6" aria-labelledby="por-tema">
      <div class="seccion-cabecera"><h2 id="por-tema" class="font-display text-white">Explora por tema</h2></div>
      <div class="mosaico-temas">
        {Object.entries(temas).map(([clave, tema]) => (
          <a href={`/blog/?tema=${clave}`} class={`fondo-${tema.color}`}>
            <b>{tema.nombre}</b>
            <span>{cuenta(clave)} guías</span>
          </a>
        ))}
      </div>
    </section>

    <section class="py-6">
      <NewsletterForm
        title="Una guía útil cada sábado"
        description="Qué herramienta probar, cómo usarla y qué límites tiene. Una por semana, en español."
        buttonLabel="Apuntarme gratis"
      />
    </section>

    <section class="py-6" aria-labelledby="utilidades">
      <div class="seccion-cabecera">
        <h2 id="utilidades" class="font-display text-white">Herramientas gratis</h2>
        <a href="/herramientas/">Ver todas →</a>
      </div>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        <a href="/herramientas/generador-prompts/" data-track="home_utility_opened" data-track-label="generador-prompts" class="utilidad">
          <b>Generador de prompts</b><span>Ordena tu petición: tarea, contexto y resultado.</span>
        </a>
        <a href="/herramientas/comparador/" data-track="home_utility_opened" data-track-label="comparador" class="utilidad">
          <b>Comparador de IA</b><span>Pon dos o tres herramientas frente a frente.</span>
        </a>
        <a href="/herramientas/preflight-datos/" data-track="home_utility_opened" data-track-label="preflight-datos" class="utilidad">
          <b>¿Puedo subir estos datos?</b><span>Revisa el riesgo antes de usar una IA.</span>
        </a>
        <a href="/empieza/" data-track="home_utility_opened" data-track-label="empieza" class="utilidad">
          <b>Empieza por tu tarea</b><span>{practicalWorkflows.length} procesos y {tools.length} fichas de herramientas.</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .utilidad {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 44px;
    padding: 14px 16px;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--superficie);
    color: var(--tinta);
  }

  .utilidad span {
    font-size: 14px;
    line-height: 1.45;
    color: var(--tinta-2);
  }

  .utilidad:hover {
    border-color: var(--marca);
  }
</style>
