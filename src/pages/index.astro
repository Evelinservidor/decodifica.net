---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import ConversionBand from '~/components/ConversionBand.astro';
import { siteConfig } from '~/lib/site-config';

const latestGuides = [
  {
    title: 'Elegir una herramienta de IA sin perder tiempo',
    href: '/blog/como-elegir-herramienta-ia/',
    description: 'Un metodo corto para decidir que probar, que descartar y que revisar antes de meter una IA en tu flujo.',
  },
  {
    title: 'Claude Skills desde cero',
    href: '/blog/claude-skills-desde-cero/',
    description: 'Como pasar de prompts sueltos a instrucciones reutilizables para trabajar mejor con Claude.',
  },
  {
    title: 'IA para organizar pendientes',
    href: '/blog/ia-organiza-pendientes/',
    description: 'Conectores, agentes y limites practicos para ordenar tareas con menos friccion.',
  },
];
---

<BaseLayout
  title="IA util en espanol"
  description="Decodifica filtra herramientas de IA, modelos y workflows para que sepas que probar, que evitar y como aplicarlo."
>
  <section class="border-b border-dark-600 bg-dark-900">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 sm:py-16 lg:grid-cols-[1fr_420px] lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
          IA practica para decidir mejor
        </p>
        <h1 class="font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          Herramientas de IA filtradas antes de que pierdas la tarde probandolas.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-dark-200">
          Decodifica separa lo util del ruido: que merece la pena probar, como aplicarlo en una tarea real y que limites conviene tener claros antes de depender de una herramienta.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="#newsletter"
            class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-brand-500/20 transition-all hover:bg-brand-600"
          >
            Recibir el filtro semanal
          </a>
          <a
            href="/herramientas"
            class="inline-flex items-center justify-center rounded-lg border border-dark-500 bg-dark-800 px-6 py-3 text-base font-semibold text-white transition-all hover:bg-dark-700"
          >
            Ver herramientas IA
          </a>
        </div>
        <dl class="mt-10 grid max-w-2xl gap-4 text-sm sm:grid-cols-3">
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <dt class="text-2xl font-bold text-white">1</dt>
            <dd class="mt-1 text-dark-300">decision practica por tema</dd>
          </div>
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <dt class="text-2xl font-bold text-white">0</dt>
            <dd class="mt-1 text-dark-300">hype gratuito</dd>
          </div>
          <div class="rounded-lg border border-dark-600 bg-dark-800 p-4">
            <dt class="text-2xl font-bold text-white">2</dt>
            <dd class="mt-1 text-dark-300">pilares: herramientas y productividad</dd>
          </div>
        </dl>
      </div>

      <div id="newsletter">
        <NewsletterForm
          title="Recibe el filtro Decodifica"
          description="Una vez por semana: una herramienta que merece la pena, una decision practica y un recurso para probarla sin empezar de cero."
          buttonLabel="Apuntarme gratis"
        />
      </div>
    </div>
  </section>

  <section class="border-b border-dark-600 bg-dark-800/50 py-12 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-3">
        <a href="/herramientas" class="rounded-lg border border-dark-600 bg-dark-800 p-6 transition hover:border-brand-500/60">
          <p class="text-sm font-semibold text-brand-300">Herramientas IA</p>
          <h2 class="mt-2 font-display text-2xl font-bold">Biblioteca filtrable por tarea</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">Compara herramientas por caso de uso, precio, privacidad, dificultad y momento adecuado.</p>
        </a>
        <a href="/recursos" class="rounded-lg border border-dark-600 bg-dark-800 p-6 transition hover:border-brand-500/60">
          <p class="text-sm font-semibold text-brand-300">Recursos IA</p>
          <h2 class="mt-2 font-display text-2xl font-bold">Prompts, flujos y guias descargables</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">El primer paso si vienes desde YouTube y quieres aplicar algo hoy, no solo leer otra noticia.</p>
        </a>
        <a href="/blog/como-elegir-herramienta-ia/" class="rounded-lg border border-dark-600 bg-dark-800 p-6 transition hover:border-brand-500/60">
          <p class="text-sm font-semibold text-brand-300">Guia base</p>
          <h2 class="mt-2 font-display text-2xl font-bold">Un metodo para elegir bien</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">La pieza base para convertir curiosidad en criterio antes de probar cualquier herramienta nueva.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold text-brand-300">Por donde empezar</p>
          <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">
            Elige mejor, prueba con criterio y guarda lo util.
          </h2>
          <p class="mt-4 text-dark-200">
            Si una herramienta te interesa, empieza por una guia, guarda el recurso que te ahorre trabajo y vuelve al filtro semanal cuando quieras seguir probando sin ruido.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {siteConfig.pillars.map((pilar) => (
            <article class="rounded-lg border border-dark-600 bg-dark-800 p-6">
              <h3 class="font-display text-xl font-bold text-white">{pilar.title}</h3>
              <p class="mt-3 text-sm leading-6 text-dark-200">{pilar.description}</p>
            </article>
          ))}
          <article class="rounded-lg border border-dark-600 bg-dark-800 p-6 sm:col-span-2">
            <h3 class="font-display text-xl font-bold text-white">Lo que no entra</h3>
            <p class="mt-3 text-sm leading-6 text-dark-200">
              No cubrimos IA como espectaculo: evitamos comparativas genericas, humo de lanzamiento y temas que no acaban en una decision util.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-dark-600 bg-dark-800/50 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-brand-300">Lecturas para empezar</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Guias con decision, no transcripciones</h2>
        </div>
        <a href="/blog" class="text-sm font-semibold text-brand-300 hover:text-brand-200">Ver todo el blog</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {latestGuides.map((guide) => (
          <a href={guide.href} class="rounded-lg border border-dark-600 bg-dark-800 p-5 transition hover:border-brand-500/60">
            <h3 class="font-display text-xl font-bold text-white">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-dark-200">{guide.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 pb-14 pt-4 sm:px-6 lg:px-8">
    <ConversionBand
      eyebrow="Siguiente paso"
      title="Empieza por el filtro semanal"
      description="Si un video te interesa, la newsletter te da la version corta: que probar, que evitar y que recurso guardar para aplicarlo."
      primaryHref="/recursos#newsletter"
      primaryLabel="Apuntarme gratis"
      secondaryHref="/comunidad"
      secondaryLabel="Ver comunidad"
    />
  </div>
</BaseLayout>
