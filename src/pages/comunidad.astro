---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import { createSupabaseServerClient } from '~/lib/supabase';

const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

// Fetch recent posts from the community feed
let posts: Array<{
  id: string;
  title: string;
  body: string;
  created_at: string;
  author_display_name: string | null;
  author_avatar_url: string | null;
  comments_count: number;
  likes_count: number;
}> = [];

if (user) {
  const { data, error } = await supabase
    .from('posts_with_author')
    .select('*')
    .order('created_at', { ascending: false })
    .limit(20);

  if (!error && data) {
    posts = data;
  }
}
---

<BaseLayout
  title="Comunidad"
  description="Comunidad de Decodifica: preguntas, recursos, networking entre fans de IA en español."
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <header class="text-center">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Comunidad</h1>
      <p class="mt-4 text-lg text-dark-200">
        Comparte, pregunta, aprende. Todo desde tu cuenta de Google.
      </p>
    </header>

    {user ? (
      <div class="mt-8 rounded-2xl border border-dark-600 bg-dark-800 p-4 text-center">
        <p class="text-sm text-dark-200">
          Conectado como <strong>{user.email}</strong>
        </p>
        <form action="/api/auth/signout" method="POST" class="mt-2">
          <Button type="submit" variant="ghost" size="sm">Cerrar sesión</Button>
        </form>
      </div>
    ) : (
      <div class="mt-8 rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-950/50 to-dark-800 p-6 text-center">
        <p class="text-dark-200">Necesitas iniciar sesión para participar.</p>
        <div class="mt-4">
          <Button href="/login" variant="primary">Iniciar sesión</Button>
        </div>
      </div>
    )}

    <!-- Feed placeholder -->
    {user && posts.length > 0 && (
      <div class="mt-8 space-y-4">
        {posts.map((post) => (
          <article class="rounded-2xl border border-dark-600 bg-dark-800 p-6">
            <h2 class="font-display text-lg font-bold">{post.title}</h2>
            <p class="mt-2 text-sm text-dark-200">{post.body.slice(0, 200)}...</p>
            <div class="mt-3 flex items-center gap-3 text-xs text-dark-300">
              <span>{post.author_display_name || 'Anónimo'}</span>
              <span>·</span>
              <time>{new Date(post.created_at).toLocaleDateString('es-ES')}</time>
              <span>·</span>
              <span>💬 {post.comments_count}</span>
              <span>·</span>
              <span>♥ {post.likes_count}</span>
            </div>
          </article>
        ))}
      </div>
    )}

    {user && posts.length === 0 && (
      <div class="mt-8 rounded-2xl border border-dark-600 bg-dark-800 p-12 text-center">
        <p class="text-dark-200">Aún no hay posts. ¡Sé el primero!</p>
      </div>
    )}
  </div>
</BaseLayout>
