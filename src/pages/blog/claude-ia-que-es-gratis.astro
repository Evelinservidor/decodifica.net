const title = "Claude IA: qué es, si es gratis y cuánto cuesta";
const description = "Qué es Claude, la IA de Anthropic: cómo usarlo en español, qué incluye el plan gratuito, cuánto cuestan Pro y Max y qué hace con tus conversaciones.";
