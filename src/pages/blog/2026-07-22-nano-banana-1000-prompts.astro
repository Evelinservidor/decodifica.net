const title = "Prompts para Nano Banana: cómo usar una biblioteca gratuita";
const description = "Cómo aprovechar la biblioteca abierta de prompts para Nano Banana Pro: una fórmula de cinco partes, usos prácticos y cómo compararla con Qwen-Image.";
const modifiedDate = "2026-10-06";
const pubDate = "2026-07-21";
const readingTime = "4 min";
const tema = "crear";
