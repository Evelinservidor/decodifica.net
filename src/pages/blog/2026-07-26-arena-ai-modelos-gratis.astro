const title = "Arena AI: qué es, si es gratis y cómo comparar modelos";
const description = "Arena (antes LMArena) es gratis: envía tu pregunta a dos IA anónimas y vota la mejor. Cómo funciona su ranking, sus créditos diarios y qué datos no subir.";
