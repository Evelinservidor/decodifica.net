---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Blog"
  description="Análisis escritos sobre IA: herramientas, trucos, comparativas, prompts. Todo en español."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">Blog</h1>
      <p class="mt-4 text-lg text-dark-200">
        Análisis escritos de 1.000-2.000 palabras. Profundizamos más que en video.
      </p>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Placeholder cards - en producción se generan desde src/content/blog/ -->
      {[1, 2, 3, 4, 5, 6].map((i) => (
        <article class="group overflow-hidden rounded-2xl border border-dark-600 bg-gradient-to-br from-dark-700 to-dark-800 transition-all hover:border-brand-500/50">
          <div class="aspect-video bg-gradient-to-br from-brand-500/20 to-dark-700"></div>
          <div class="p-6">
            <div class="mb-2 flex items-center gap-2 text-xs text-dark-300">
              <span class="rounded-full bg-brand-500/10 px-2 py-0.5 text-brand-400">Pilar 1</span>
              <span>·</span>
              <time>Hace {i} día{i === 1 ? '' : 's'}</time>
            </div>
            <h2 class="font-display text-xl font-bold text-white group-hover:text-brand-400">
              Post #{i} — Próximamente
            </h2>
            <p class="mt-2 text-sm text-dark-200">
              Estamos preparando el contenido. Pronto verás análisis detallados de las mejores herramientas de IA.
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center text-sm text-dark-300">
      Suscríbete a la <a href="/" class="text-brand-400 hover:text-brand-300">newsletter</a> para no perderte ningún post.
    </div>
  </div>
</BaseLayout>
