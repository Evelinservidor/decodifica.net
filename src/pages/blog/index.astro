---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';

import { blogPostIndex } from '~/lib/blog-post-index';
import { nombreTema, temas } from '~/lib/temas';

// Se genera a partir de los propios artículos: las redirecciones quedan fuera solas.
const posts = blogPostIndex;
const VISIBLES = 12;
const quitarTildes = (texto: string) => texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
---

<BaseLayout
  title="Guías de IA práctica en español"
  description="Guías de IA en español con fuentes: herramientas gratis, prompts, comparativas y pasos para aplicarlas en tareas reales sin perder tiempo."
>
  <div class="contenedor">
    <header class="pb-2 pt-7">
      <h1 class="font-display text-[clamp(30px,7vw,46px)] leading-tight text-white">Guías de IA práctica</h1>
      <p class="mt-2 max-w-2xl text-base leading-relaxed text-dark-200">
        {posts.length} guías en español con fuentes oficiales: qué es cada herramienta, cuánto cuesta y cómo se usa.
      </p>
      <label for="buscar" class="buscador mt-4">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sr-only">Buscar guías</span>
        <input id="buscar" type="search" placeholder="Busca una herramienta o una tarea…" autocomplete="off" />
      </label>
    </header>

    <div class="chips my-4" role="group" aria-label="Filtrar por tema">
      <button type="button" class="chip" data-tema="" aria-pressed="true">Todas</button>
      {Object.entries(temas).map(([clave, tema]) => (
        <button type="button" class="chip" data-tema={clave} aria-pressed="false">{tema.nombre}</button>
      ))}
    </div>

    <p id="sin-resultados" class="hidden py-8 text-dark-200" role="status">
      No hay ninguna guía con esa búsqueda. Prueba con otra palabra o <a class="text-brand-400 underline" href="/empieza/">empieza por tu tarea</a>.
    </p>

    <div id="lista-guias" class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => (
        <div
          data-guia
          data-tema={post.tema ?? ''}
          data-texto={quitarTildes(`${post.title} ${post.description} ${post.tags.join(' ')} ${nombreTema(post.tema)}`)}
        >
          <TarjetaArticulo post={post} prioridad={i === 0} nivel="h2" track="blog_card_click" />
        </div>
      ))}
    </div>

    <div class="mt-8 flex justify-center">
      <button id="ver-mas" type="button" class="hidden min-h-[48px] rounded-xl border border-dark-600 bg-dark-800 px-5 font-bold text-white hover:border-brand-400">
        Ver más guías
      </button>
    </div>

    <section class="mt-12">
      <NewsletterForm
        title="Una guía útil cada sábado"
        description="Qué herramienta probar, cómo usarla y qué límites tiene. Si prefieres material para descargar, mira los recursos gratis."
        buttonLabel="Apuntarme gratis"
      />
      <p class="mt-4 text-sm text-dark-200">
        ¿Buscas plantillas y prompts para descargar? <a href="/recursos/" class="font-semibold text-brand-400 underline">Ver recursos gratis</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ VISIBLES }}>
  (() => {
    const guias = [...document.querySelectorAll('[data-guia]')];
    const chips = [...document.querySelectorAll('.chip[data-tema]')];
    const buscar = document.getElementById('buscar');
    const verMas = document.getElementById('ver-mas');
    const vacio = document.getElementById('sin-resultados');
    const normalizar = (texto) => texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
    let tema = new URLSearchParams(location.search).get('tema') || '';
    let todas = false;

    function pintar() {
      const q = normalizar(buscar.value);
      const palabras = q.split(/\s+/).filter(Boolean);
      const filtrando = Boolean(tema || palabras.length);
      let visibles = 0;
      let coinciden = 0;
      for (const guia of guias) {
        const ok = (!tema || guia.dataset.tema === tema) && palabras.every((p) => guia.dataset.texto.includes(p));
        if (ok) coinciden += 1;
        const mostrar = ok && (filtrando || todas || coinciden <= VISIBLES);
        guia.hidden = !mostrar;
        if (mostrar) visibles += 1;
      }
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.tema === tema)));
      vacio.classList.toggle('hidden', coinciden > 0);
      const quedan = coinciden - visibles;
      verMas.classList.toggle('hidden', quedan <= 0);
      verMas.textContent = `Ver ${quedan} guías más`;
    }

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        tema = chip.dataset.tema;
        const url = new URL(location.href);
        if (tema) url.searchParams.set('tema', tema);
        else url.searchParams.delete('tema');
        history.replaceState(null, '', url);
        pintar();
      }),
    );
    buscar.addEventListener('input', pintar);
    verMas.addEventListener('click', () => {
      todas = true;
      pintar();
    });
    if (location.hash === '#buscar') buscar.focus();
    pintar();
  })();
</script>

<style>
  .buscador {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 640px;
    min-height: 50px;
    padding: 0 14px;
    border: 1px solid rgb(var(--theme-500));
    border-radius: 12px;
    background: var(--superficie);
    color: var(--tinta-3);
  }

  .buscador:focus-within {
    border-color: var(--marca);
    box-shadow: 0 0 0 3px rgb(79 70 229 / 18%);
  }

  .buscador svg {
    flex: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .buscador input {
    flex: 1;
    min-width: 0;
    height: 48px;
    border: 0;
    background: none;
    font-size: 16px;
    color: var(--tinta);
    outline: none;
  }

  [data-guia][hidden] {
    display: none;
  }
</style>
