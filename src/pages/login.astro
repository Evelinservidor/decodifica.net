---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { env } from '~/lib/env';
---

<BaseLayout
  title="Iniciar sesión"
  description="Accede a la comunidad de Decodifica con tu cuenta de Google o email."
>
  <div class="mx-auto max-w-md px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="rounded-2xl border border-dark-600 bg-dark-800 p-8">
      <h1 class="font-display text-3xl font-bold">Iniciar sesión</h1>
      <p class="mt-2 text-sm text-dark-200">
        Accede con tu cuenta de Google o por magic link.
      </p>

      <!-- Google OAuth button - handled by client-side Supabase -->
      <button
        id="google-login"
        type="button"
        class="mt-6 inline-flex w-full items-center justify-center gap-3 rounded-lg bg-brand-500 px-5 py-3 font-semibold text-white transition-colors hover:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-800"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
        </svg>
        Continuar con Google
      </button>

      <div class="my-6 flex items-center gap-3 text-xs text-dark-300">
        <div class="h-px flex-1 bg-dark-600"></div>
        <span>o</span>
        <div class="h-px flex-1 bg-dark-600"></div>
      </div>

      <!-- Magic link form - handled by client-side Supabase -->
      <form id="magic-link-form" class="space-y-3">
        <label for="email" class="block text-sm font-medium text-dark-200">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="tu@email.com"
          class="w-full rounded-lg border border-dark-500 bg-dark-900 px-4 py-2.5 text-white placeholder-dark-300 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/20"
        />
        <button
          type="submit"
          class="w-full rounded-lg bg-dark-700 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-dark-600 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-dark-800"
        >
          Enviar magic link
        </button>
      </form>

      <div id="status" class="mt-4 hidden text-sm"></div>
    </div>

    <p class="mt-4 text-center text-xs text-dark-300">
      Solo te pedimos email. Sin password que recordar.
    </p>
  </div>

  <script define:vars={{ supabaseUrl: env.PUBLIC_SUPABASE_URL, supabaseAnonKey: env.PUBLIC_SUPABASE_ANON_KEY }}>
    import { createBrowserClient } from 'https://esm.sh/@supabase/ssr@0.5.2';

    const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);

    // Google OAuth
    document.getElementById('google-login')?.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/auth/callback.html' },
      });
      if (error) {
        const status = document.getElementById('status');
        status.className = 'mt-4 text-sm text-red-400';
        status.textContent = 'Error: ' + error.message;
      }
    });

    // Magic link
    document.getElementById('magic-link-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = e.target.email.value;
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: window.location.origin + '/auth/callback.html' },
      });
      const status = document.getElementById('status');
      if (error) {
        status.className = 'mt-4 text-sm text-red-400';
        status.textContent = 'Error: ' + error.message;
      } else {
        status.className = 'mt-4 text-sm text-green-400';
        status.textContent = '¡Listo! Revisa tu email.';
      }
    });
  </script>
</BaseLayout>
