---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/lib/site-config';
---

<BaseLayout
  title="Contacto"
  description="Cómo contactar con Decodifica."
>
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <h1 class="font-display text-4xl font-bold">Contacto</h1>
    <p class="mt-4 text-lg text-dark-200">
      Para colaboraciones, prensa, o cualquier otra cosa:
    </p>

    <div class="mt-8 space-y-4">
      <a
        href={`mailto:${siteConfig.author.email}`}
        class="block rounded-2xl border border-dark-600 bg-dark-800 p-6 transition-colors hover:border-brand-500/50"
      >
        <div class="text-sm text-dark-300">Email</div>
        <div class="mt-1 text-lg font-semibold text-white">{siteConfig.author.email}</div>
      </a>

      <a
        href={siteConfig.social.youtube}
        target="_blank"
        rel="noopener"
        class="block rounded-2xl border border-dark-600 bg-dark-800 p-6 transition-colors hover:border-brand-500/50"
      >
        <div class="text-sm text-dark-300">YouTube (comentarios)</div>
        <div class="mt-1 text-lg font-semibold text-white">@decodificaia</div>
      </a>
    </div>
  </div>
</BaseLayout>
