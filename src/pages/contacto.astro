---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/lib/site-config';
---

<BaseLayout
  title="Contacto"
  description="Como contactar con Decodifica para consultas, colaboraciones, privacidad o propuestas editoriales."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">
      Contacto Decodifica
    </p>
    <h1 class="font-display text-4xl font-bold">Hablemos por el canal correcto</h1>
    <p class="mt-4 text-lg leading-8 text-dark-200">
      Para consultas editoriales, colaboraciones, privacidad, errores o propuestas de herramientas IA, usa el email publico de Decodifica.
    </p>

    <div class="mt-8 grid gap-4">
      <a
        href={`mailto:${siteConfig.author.email}`}
        class="block rounded-lg border border-dark-600 bg-dark-800 p-6 transition-colors hover:border-brand-500/50"
      >
        <div class="text-sm text-dark-300">Email principal</div>
        <div class="mt-1 text-lg font-semibold text-white">{siteConfig.author.publicEmailLabel}</div>
        <p class="mt-2 text-sm text-dark-200">Consultas generales, privacidad, correcciones, dudas de lectores y contacto legal.</p>
      </a>

      <a
        href={`mailto:${siteConfig.author.collaborationsEmail}`}
        class="block rounded-lg border border-dark-600 bg-dark-800 p-6 transition-colors hover:border-brand-500/50"
      >
        <div class="text-sm text-dark-300">Colaboraciones</div>
        <div class="mt-1 text-lg font-semibold text-white">{siteConfig.author.collaborationsEmail}</div>
        <p class="mt-2 text-sm text-dark-200">Promociones, marcas, herramientas IA, partners y propuestas comerciales.</p>
      </a>

      <a
        href="/newsletter"
        class="block rounded-lg border border-dark-600 bg-dark-800 p-6 transition-colors hover:border-brand-500/50"
      >
        <div class="text-sm text-dark-300">Newsletter</div>
        <div class="mt-1 text-lg font-semibold text-white">Filtro semanal Decodifica</div>
        <p class="mt-2 text-sm text-dark-200">La forma estable de seguir recursos, temas y pruebas nuevas.</p>
      </a>

      <a
        href={siteConfig.social.youtube}
        target="_blank"
        rel="noopener"
        class="block rounded-lg border border-dark-600 bg-dark-800 p-6 transition-colors hover:border-brand-500/50"
      >
        <div class="text-sm text-dark-300">YouTube</div>
        <div class="mt-1 text-lg font-semibold text-white">@decodificaia</div>
        <p class="mt-2 text-sm text-dark-200">Comentarios sobre videos, dudas publicas y temas sugeridos por la audiencia.</p>
      </a>

      <div class="rounded-lg border border-dark-600 bg-dark-800 p-6">
        <div class="text-sm text-dark-300">Redes sociales</div>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener"
            class="rounded-lg border border-dark-600 bg-dark-900 px-4 py-3 text-sm font-semibold text-white transition-colors hover:border-brand-500/50"
          >
            Facebook
          </a>
          <a
            href={siteConfig.social.bluesky}
            target="_blank"
            rel="noopener"
            class="rounded-lg border border-dark-600 bg-dark-900 px-4 py-3 text-sm font-semibold text-white transition-colors hover:border-brand-500/50"
          >
            Bluesky
          </a>
          <a
            href={siteConfig.social.tiktok}
            target="_blank"
            rel="noopener"
            class="rounded-lg border border-dark-600 bg-dark-900 px-4 py-3 text-sm font-semibold text-white transition-colors hover:border-brand-500/50"
          >
            TikTok
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
