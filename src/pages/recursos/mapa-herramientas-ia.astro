---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import { tools } from '~/data/tools';
import { siteConfig } from '~/lib/site-config';

const pageUrl = `${siteConfig.url}/recursos/mapa-herramientas-ia/`;
const title = 'Mapa Decodifica de herramientas IA';
const description = 'Mapa practico para decidir que herramienta de IA usar segun tu tarea: escribir, investigar, estudiar, programar, disenar, presentar o crear voz.';

const routes = [
  { task: 'Escribir, resumir o arrancar una idea', start: 'ChatGPT', why: 'Punto de entrada versatil cuando todavia no sabes que herramienta especializada necesitas.', href: '/herramientas/chatgpt/', next: 'Si el texto es largo o delicado, compara con Claude.' },
  { task: 'Pulir documentos, emails o tono profesional', start: 'Claude', why: 'Encaja cuando la calidad depende de matiz, contexto largo y escritura cuidada.', href: '/herramientas/claude/', next: 'Usa ChatGPT vs Claude si dudas entre ambos.' },
  { task: 'Investigar un tema desde cero', start: 'Perplexity', why: 'Ayuda a descubrir fuentes, contexto y terminos relevantes antes de profundizar.', href: '/herramientas/perplexity/', next: 'Pasa las fuentes buenas a NotebookLM para trabajarlas.' },
  { task: 'Estudiar o trabajar con fuentes propias', start: 'NotebookLM', why: 'Funciona mejor cuando ya tienes PDFs, notas, webs o videos que quieres entender.', href: '/herramientas/notebooklm/', next: 'Usa NotebookLM vs Perplexity si dudas entre buscar o analizar.' },
  { task: 'Crear una presentacion desde una idea', start: 'Gamma', why: 'Convierte esquemas, notas y prompts en un primer deck o documento visual.', href: '/herramientas/gamma/', next: 'Pulir marca y formatos puede ser mejor en Canva AI.' },
  { task: 'Crear piezas visuales para marca o redes', start: 'Canva AI', why: 'Encaja con plantillas, formatos, brand kits y materiales visuales recurrentes.', href: '/herramientas/canva-ai/', next: 'Usa Gamma vs Canva AI si dudas entre estructura o diseno.' },
  { task: 'Generar locuciones, doblaje o voz IA', start: 'ElevenLabs', why: 'Opcion fuerte para voz publicable, con cuidado extra en permisos y uso comercial.', href: '/herramientas/elevenlabs/', next: 'Mira alternativas si priorizas API, latencia o clonacion segura.' },
  { task: 'Trabajar con codigo desde terminal', start: 'Qwen Code', why: 'Tiene sentido si ya trabajas con repositorios, git, tests y tareas tecnicas supervisadas.', href: '/herramientas/qwen-code/', next: 'No lo uses sin revisar diff, permisos y cambios de seguridad.' },
  { task: 'Comparar modelos o probar bajo coste', start: 'DeepSeek', why: 'Sirve como segunda opinion y alternativa de coste bajo, sobre todo para codigo y razonamiento.', href: '/herramientas/deepseek/', next: 'Evitalo con datos sensibles si no has revisado privacidad.' },
];

const checks = [
  'Que resultado necesito hoy?',
  'Voy a subir datos sensibles o material de clientes?',
  'Necesito buscar fuentes nuevas o trabajar con fuentes propias?',
  'Esto sera una prueba puntual o un flujo repetido?',
  'Puedo revisar el resultado antes de publicarlo o automatizarlo?',
];

const comparisonLinks = [
  { label: 'ChatGPT vs Claude', href: '/herramientas/chatgpt-vs-claude/' },
  { label: 'NotebookLM vs Perplexity', href: '/herramientas/notebooklm-vs-perplexity/' },
  { label: 'Gamma vs Canva AI', href: '/herramientas/gamma-vs-canva-ai/' },
  { label: 'Alternativas a ElevenLabs', href: '/herramientas/alternativas-elevenlabs/' },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: pageUrl,
  datePublished: '2026-07-08',
  dateModified: '2026-07-08',
  author: { '@type': 'Organization', name: 'Decodifica', url: siteConfig.url },
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  pubDate="2026-07-08"
  modifiedDate="2026-07-08"
  keywords={['mapa herramientas IA', 'herramientas IA', 'que IA usar', 'Decodifica']}
  section="Recursos IA"
>
  <article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <nav class="mb-8 text-sm text-dark-300" aria-label="Migas de pan">
      <a href="/recursos/" class="text-brand-300 hover:text-brand-200">Recursos IA</a>
      <span class="mx-2">/</span>
      <span>Mapa de herramientas IA</span>
    </nav>

    <header class="grid gap-8 lg:grid-cols-[1fr_380px] lg:items-start">
      <div>
        <p class="mb-4 inline-flex rounded-lg border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">Recurso Decodifica</p>
        <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">Mapa Decodifica: que IA usar segun tu tarea</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-dark-200">
          No necesitas probar veinte herramientas. Necesitas saber cual abrir primero, que riesgo revisar y cuando cambiar de herramienta.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/herramientas/" class="inline-flex rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">Abrir biblioteca</a>
          <a href="#mapa" class="inline-flex rounded-lg border border-brand-700 px-4 py-2.5 text-sm font-semibold text-brand-300 transition hover:bg-dark-800">Ver mapa</a>
        </div>
      </div>
      <NewsletterForm
        title="Recibe el mapa y nuevas decisiones"
        description="Te enviamos el filtro semanal: que herramienta mirar, para que sirve y que comprobar antes de pagar o subir datos."
        buttonLabel="Recibir el filtro"
      />
    </header>

    <section class="mt-12 grid gap-5 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:grid-cols-[.75fr_1.25fr] lg:p-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">Metodo rapido</p>
        <h2 class="mt-2 font-display text-3xl font-bold">Cinco preguntas antes de abrir una app</h2>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2">
        {checks.map((check, index) => (
          <li class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200">
            <span class="text-xs font-semibold text-brand-300">Pregunta {index + 1}</span>
            <p class="mt-1">{check}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="mapa" class="mt-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-brand-300">Mapa de decision</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Empieza por la tarea</h2>
        </div>
        <p class="text-sm text-dark-300">{tools.length} fichas conectadas</p>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {routes.map((route) => (
          <a href={route.href} class="rounded-lg border border-dark-600 bg-dark-800 p-5 transition hover:border-brand-500/60">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-lg bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300">{route.start}</span>
              <h3 class="font-display text-xl font-bold text-white">{route.task}</h3>
            </div>
            <p class="mt-3 text-sm leading-6 text-dark-200">{route.why}</p>
            <p class="mt-3 text-sm leading-6 text-dark-300">{route.next}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:p-8">
      <div class="grid gap-5 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold text-brand-300">Cuando dudas entre dos</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Usa una comparativa</h2>
          <p class="mt-3 text-sm leading-6 text-dark-200">Si dos herramientas parecen resolver la misma tarea, la pregunta correcta suele ser en que fase del trabajo estas.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {comparisonLinks.map((link) => (
            <a href={link.href} class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm font-semibold text-brand-300 transition hover:border-brand-500/60 hover:text-brand-200">{link.label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-12 grid gap-5 rounded-lg border border-dark-600 bg-dark-800 p-6 lg:grid-cols-[.75fr_1.25fr] lg:p-8">
      <div>
        <p class="text-sm font-semibold text-brand-300">Regla de seguridad</p>
        <h2 class="mt-2 font-display text-3xl font-bold">No subas datos antes de decidir el riesgo</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">Bajo riesgo.</strong> Ideas, borradores, textos publicos y pruebas sin datos personales.</div>
        <div class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">Riesgo medio.</strong> Documentos internos, marca, material de cliente anonimizado o informacion no publica.</div>
        <div class="rounded-lg border border-dark-600 bg-dark-900 p-4 text-sm leading-6 text-dark-200"><strong class="text-white">Alto riesgo.</strong> Datos personales, contratos, salud, legal, voz real, codigo sensible o secretos.</div>
      </div>
    </section>

    <div id="newsletter" class="mt-12">
      <NewsletterForm
        title="Guarda el mapa y recibe la siguiente actualizacion"
        description="Cuando anadamos nuevas fichas, comparativas o recursos, te enviaremos el filtro Decodifica para no probar herramientas al azar."
        buttonLabel="Recibir actualizaciones"
      />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Recursos IA', item: `${siteConfig.url}/recursos/` },
      { '@type': 'ListItem', position: 2, name: 'Mapa de herramientas IA', item: pageUrl },
    ],
  })} />
</BaseLayout>
