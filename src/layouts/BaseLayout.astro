---
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SEO from '~/components/SEO.astro';
import CookieConsent from '~/components/CookieConsent.astro';
import ConversionTracker from '~/components/ConversionTracker.astro';
import { env } from '~/lib/env';
import '~/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // Article-specific (pass-through to SEO for JSON-LD)
  type?: 'website' | 'article';
  pubDate?: string;
  modifiedDate?: string;
  authorName?: string;
  authorUrl?: string;
  imageAlt?: string;
  keywords?: string[];
  section?: string;
}

const {
  title,
  description,
  ogImage,
  type,
  pubDate,
  modifiedDate,
  authorName,
  authorUrl,
  imageAlt,
  keywords,
  section,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('decodifica-theme');
        document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260711" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=20260711" />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      pubDate={pubDate}
      modifiedDate={modifiedDate}
      authorName={authorName}
      authorUrl={authorUrl}
      imageAlt={imageAlt}
      keywords={keywords}
      section={section}
    />

    <!-- RSS auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title="Decodifica RSS" href="/rss.xml" />
  </head>

  <body class="min-h-screen bg-dark-900 font-sans text-white antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand-500 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="main" class="min-h-[calc(100vh-200px)]">
      <slot />
    </main>

    <Footer />
    <ConversionTracker />
    <CookieConsent
      plausibleDomain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
      plausibleScriptSrc={env.PUBLIC_PLAUSIBLE_SCRIPT_SRC}
    />
  </body>
</html>
