---
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SEO from '~/components/SEO.astro';
import CookieConsent from '~/components/CookieConsent.astro';
import ConversionTracker from '~/components/ConversionTracker.astro';
import { env } from '~/lib/env';
import { esNoindex } from '~/lib/poda-seo';
import '~/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // Article-specific (pass-through to SEO for JSON-LD)
  type?: 'website' | 'article';
  pubDate?: string;
  modifiedDate?: string;
  authorName?: string;
  authorUrl?: string;
  imageAlt?: string;
  keywords?: string[];
  section?: string;
  citations?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  type,
  pubDate,
  modifiedDate,
  authorName,
  authorUrl,
  imageAlt,
  keywords,
  section,
  citations,
  noindex,
} = Astro.props;
// Limpieza del plan SEO: las páginas de src/data/poda-seo.json llevan noindex.
const sinIndexar = noindex || esNoindex(Astro.url.pathname);
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>
      try {
        // Claro por defecto; el modo oscuro solo si la persona lo eligió con el botón.
        if (localStorage.getItem('decodifica-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>


    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260711" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=20260711" />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      pubDate={pubDate}
      modifiedDate={modifiedDate}
      authorName={authorName}
      authorUrl={authorUrl}
      imageAlt={imageAlt}
      keywords={keywords}
      section={section}
      citations={citations}
      noindex={sinIndexar}
    />

    <!-- RSS auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title="Decodifica RSS" href="/rss.xml" />
  </head>

  <body class="site-body min-h-screen antialiased">
    <a
      href="#main"
      class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-dark-900"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="main" class="site-main min-h-[calc(100vh-200px)]" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <ConversionTracker />
    <script is:inline>
      // Tablas y bloques que se deslizan de lado: también con el teclado.
      document.querySelectorAll('.overflow-x-auto, pre').forEach((el) => {
        if (el.scrollWidth > el.clientWidth && !el.hasAttribute('tabindex')) el.tabIndex = 0;
      });
    </script>
    <CookieConsent
      plausibleDomain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
      plausibleScriptSrc={env.PUBLIC_PLAUSIBLE_SCRIPT_SRC}
    />
  </body>
</html>
