# Decodifica - Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# ============================================
# SUPABASE (public, safe to expose in frontend)
# ============================================
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# ============================================
# BUTTONDOWN (newsletter)
# ============================================
PUBLIC_BUTTONDOWN_USERNAME=decodifica

# ============================================
# ANALYTICS
# ============================================
PUBLIC_PLAUSIBLE_DOMAIN=decodifica.net

# ============================================
# SITE CONFIG
# ============================================
PUBLIC_SITE_URL=https://decodifica.net
PUBLIC_SITE_NAME=Decodifica
